# Supabase：先在 SQL Editor 运行 prisma/hui-v2-prepare.sql
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 微信小程序（不得放进小程序代码包）
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_ENV_VERSION=release

# 独立随机值，至少 32 字符；轮换 AUTH_SECRET 前必须设计身份重新关联方案。
AUTH_SECRET=
CRON_SECRET=

# 平台管理员：密码哈希为 salt:scryptHex，使用 scripts/hash-admin-password.cjs 生成
ADMIN_LOGIN=
ADMIN_PASSWORD_HASH=

# 写作服务：沿用现有 DeepSeek 也可，不会在未确认任务时调用
DEEPSEEK_API_KEY=
WRITING_API_KEY=
WRITING_API_URL=https://api.deepseek.com/v1/chat/completions
WRITING_MODEL=deepseek-flash

# 图片理解服务暂不启用，以下三项目前无需填写
VISION_API_KEY=
VISION_API_URL=
VISION_MODEL=

APP_NAME=慧共创
# 本地 worker 可选，线上使用已配置的 cron
HUI_WORKER_URL=http://127.0.0.1:3000
