.page.with-share-dock,.reader-page.with-share-dock{padding-bottom:calc(110px + env(safe-area-inset-bottom))}.shared-reader-title{font-size:22px;font-weight:600;line-height:1.5;overflow-wrap:anywhere;margin-bottom:20px}.shared-reader-dock{position:fixed;left:0;right:0;bottom:0;z-index:25;display:flex;align-items:center;gap:12px;padding:12px 20px calc(12px + env(safe-area-inset-bottom));background:var(--ui-bg);border-top:1px solid var(--ui-line)}.shared-reader-dock>button,.page .shared-reader-dock>button{display:flex;align-items:center;justify-content:center;flex:1;width:0;min-width:0;max-width:none;min-height:48px;margin:0;padding:12px 8px;border:1px solid var(--ui-line);border-radius:10px;background:var(--ui-surface);color:var(--ui-green);font-size:15px;line-height:1.5;font-weight:500}.shared-reader-dock>button.primary,.page .shared-reader-dock>button.primary{background:var(--ui-green);border-color:var(--ui-green);color:#fff}
