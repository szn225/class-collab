.login-page {
  padding-top: 56rpx;
}
.login-art {
  height: 340rpx;
  position: relative;
  margin-bottom: 32rpx;
  background: #e9efff;
  border-radius: 40rpx;
  overflow: hidden;
}
.art-paper {
  position: absolute;
  left: 64rpx;
  top: 40rpx;
  width: 400rpx;
  height: 280rpx;
  background: #fff;
  transform: rotate(-6deg);
  border: 2rpx solid #cbd8f8;
  border-radius: 20rpx;
  padding: 24rpx;
}
.notebook {
  width: 88rpx;
  height: 88rpx;
}
.art-line {
  height: 12rpx;
  width: 80%;
  background: #ddf3e8;
  border-radius: 8rpx;
  margin: 14rpx 0;
}
.art-line.short {
  width: 55%;
}
.art-caption {
  font-size: 26rpx;
  color: #2457d6;
  font-weight: 600;
}
.art-star {
  position: absolute;
  right: 40rpx;
  top: 24rpx;
  width: 96rpx;
  height: 96rpx;
  transform: rotate(12deg);
}
.art-sticker {
  position: absolute;
  bottom: 28rpx;
  right: 20rpx;
  background: #ffd66b;
  padding: 12rpx 20rpx;
  border-radius: 12rpx;
  font-size: 24rpx;
  transform: rotate(5deg);
}
.login-card {
  margin-top: 40rpx;
}
.login-card .field-label {
  margin-top: 0;
}
.login-card .small {
  margin: 14rpx 0 28rpx;
}
