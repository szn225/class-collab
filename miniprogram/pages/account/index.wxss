page{background:var(--ui-bg)}.account{padding:24px 20px calc(40px + env(safe-area-inset-bottom))}
.identity-card{display:flex;align-items:center;gap:12px;padding:0 0 24px;border-bottom:1px solid var(--ui-line);margin-bottom:24px}.avatar{display:flex;align-items:center;justify-content:center;width:44px;height:44px;border-radius:50%;background:var(--ui-green-soft);border:1px solid var(--ui-green-line);color:var(--ui-green);font-size:16px;flex:none}.identity-copy{flex:1;min-width:0}.identity-name{font-size:19px;font-weight:600;overflow-wrap:break-word}.sub,.section-label,.row-meta,.reveal-title{font-size:15px;line-height:1.6;color:var(--ui-muted)}.sub{margin-top:4px}.section-label{margin:20px 0 12px}.h2{font-size:19px;font-weight:600}
.card{padding:20px;border:1px solid var(--ui-blue-line);border-radius:16px;background:var(--ui-blue-soft);margin-bottom:20px}.student-summary{display:flex;justify-content:space-between;align-items:flex-start;gap:12px;margin-bottom:16px}
.account button{display:flex;align-items:center;justify-content:center;gap:8px;width:100%;max-width:none;min-height:44px;padding:10px 16px;margin:12px 0 0;border:1px solid var(--ui-line);border-radius:10px;background:var(--ui-surface);color:var(--ui-green);font-size:16px;font-weight:500;line-height:1.5;white-space:normal}.account .primary{background:var(--ui-green);border-color:var(--ui-green);color:#fff}.account .login-pill,.account .small-link{width:auto;margin:0;flex:none;border:0;background:transparent;padding:8px;color:var(--ui-green);font-size:15px}
.menu-group{background:transparent}.account .menu-row{justify-content:space-between;text-align:left;border:0;border-bottom:1px solid var(--ui-line);border-radius:0;background:transparent;margin:0;padding:16px 0;min-height:56px;color:var(--ui-ink)}.row-state{display:flex;align-items:center;gap:8px;flex:none}.row-meta{text-align:right}.reveal{background:var(--ui-surface);border:1px solid var(--ui-line);border-radius:12px;padding:16px;margin:12px 0}.card .reveal{padding:16px 0 0;border:0;border-top:1px solid var(--ui-blue-line);border-radius:0;background:transparent}.reveal-title{margin-bottom:12px}.account .student-option{justify-content:space-between;text-align:left}.account .selected{background:var(--ui-green-soft);border-color:var(--ui-green-line)}
.account input{width:100%;min-height:48px;padding:12px;border:1px solid var(--ui-line);border-radius:10px;margin-top:12px;background:var(--ui-surface);font-size:16px}.account .danger{background:transparent;border:0;color:var(--ui-danger)}.account .back-link{background:transparent;border:0;color:var(--ui-muted);width:auto}.error{color:var(--ui-danger);font-size:15px;line-height:1.7;padding:12px 0}

.release-version{padding:28px 0 0;text-align:center;font-size:15px;line-height:1.5;color:var(--ui-muted)}

.identity-card .avatar{overflow:hidden}.identity-card .avatar image{display:block;width:100%;height:100%}
