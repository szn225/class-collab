<app-nav title="我的" show-back="{{true}}"/>
<view class="account">

 <view class="identity-card"><view class="avatar"><image wx:if="{{user.avatarUrl && !avatarBroken}}" src="{{user.avatarUrl}}" mode="aspectFill" binderror="avatarError"/><text wx:else>{{user ? (user.name ? user.name[0] : '我') : '访'}}</text></view><view class="identity-copy"><view class="identity-name">{{user ? (user.name || '微信用户') : '访客'}}</view><view class="sub">{{user ? '账号已登录' : '本机记录'}}</view></view><button wx:if="{{!user}}" class="login-pill" bindtap="signIn">登录</button><button wx:else class="login-pill" bindtap="editProfile">编辑</button></view>
 <view wx:if="{{error}}" class="error">{{error}}</view>
 <view class="section-label">成绩空间</view>
 <view class="card"><view class="student-summary"><view><view class="h2" wx:for="{{students}}" wx:key="id" wx:if="{{active === item.id}}">{{item.name}}</view><view class="sub">{{sync.count}} 次考试 · {{sync.enabled ? (sync.conflict ? '需要处理冲突' : sync.dirty || sync.pending ? '待同步' : '已同步') : '本机保存'}}</view></view><button class="small-link" data-section="students" bindtap="toggle">管理</button></view><button class="primary" bindtap="grades">查看成绩</button>
 <view wx:if="{{section === 'students'}}" class="reveal"><view class="reveal-title">切换学生</view><button wx:for="{{students}}" wx:key="id" data-id="{{item.id}}" bindtap="selectStudent" disabled="{{busy}}" class="student-option {{active === item.id ? 'selected' : ''}}">{{item.name}} <ui-icon wx:if="{{active === item.id}}" name="check" tone="accent" size="20px"/></button><input value="{{studentName}}" data-field="studentName" bindinput="input" maxlength="30" placeholder="新学生称呼" placeholder-class="input-placeholder" placeholder-style="font-size:15px;font-weight:400;color:#65736B"/><button bindtap="addStudent" disabled="{{busy || !studentName}}">添加学生</button></view></view>
 <view class="menu-group">
 <button class="menu-row" data-section="sync" bindtap="toggle"><text>云端同步</text><view class="row-state"><text class="row-meta">{{sync.enabled ? '已开启' : '未开启'}}</text><ui-icon name="{{section === 'sync' ? 'chevron-up' : 'chevron-down'}}" size="20px"/></view></button>
 <view wx:if="{{section === 'sync'}}" class="reveal"><view class="sub">{{user ? '为当前学生保存到账号，换设备也能继续。' : '登录后可为当前学生开启同步。'}}</view><view class="error" wx:if="{{sync.error}}">{{sync.error}}</view><button wx:if="{{!user}}" class="primary" bindtap="signIn">登录账号</button><block wx:else><button wx:if="{{!sync.enabled}}" class="primary" bindtap="enableSync" disabled="{{busy}}" loading="{{busy}}">开启同步</button><block wx:else><button wx:if="{{!sync.conflict}}" class="primary" bindtap="syncNow" disabled="{{busy}}" loading="{{busy}}">立即同步</button><block wx:else><view class="sub">两份资料有差异，请选择要保留的版本。</view><button data-choice="local" bindtap="resolveConflict" disabled="{{busy}}">保留本机版本</button><button data-choice="remote" bindtap="resolveConflict" disabled="{{busy}}">采用云端版本</button></block><button bindtap="stopSync" disabled="{{busy}}">暂停同步</button></block></block></view>
 <block wx:if="{{user && guestStudents.length}}"><button class="menu-row" data-section="import" bindtap="toggle"><text>导入本机记录</text><ui-icon name="{{section === 'import' ? 'chevron-up' : 'chevron-down'}}" size="20px"/></button><view wx:if="{{section === 'import'}}" class="reveal"><view class="sub">导入到上方当前学生，原记录会保留。</view><button wx:for="{{guestStudents}}" wx:key="id" data-id="{{item.id}}" bindtap="importGuest" disabled="{{busy}}">{{item.name}} · {{item.count}} 次考试　导入</button></view></block>
 <block wx:if="{{user}}"><button class="menu-row" data-section="profile" bindtap="toggle"><text>账号设置</text><ui-icon name="{{section === 'profile' ? 'chevron-up' : 'chevron-down'}}" size="20px"/></button><view wx:if="{{section === 'profile'}}" class="reveal"><input value="{{name}}" data-field="name" bindinput="input" maxlength="30" placeholder="显示称呼（选填）" placeholder-class="input-placeholder" placeholder-style="font-size:15px;font-weight:400;color:#65736B"/><button bindtap="saveName" disabled="{{busy || !name}}">保存称呼</button><button class="danger" bindtap="logout" disabled="{{busy}}">退出账号</button></view></block>
 <block wx:if="{{backups.length}}"><button class="menu-row" data-section="backups" bindtap="toggle"><text>历史备份</text><ui-icon name="{{section === 'backups' ? 'chevron-up' : 'chevron-down'}}" size="20px"/></button><view wx:if="{{section === 'backups'}}" class="reveal"><button wx:for="{{backups}}" wx:key="id" data-id="{{item.id}}" bindtap="restoreBackup" disabled="{{busy}}">{{item.time}} · 恢复</button></view></block>
 <button class="menu-row" data-section="help" bindtap="toggle"><text>数据与隐私</text><ui-icon name="{{section === 'help' ? 'chevron-up' : 'chevron-down'}}" size="20px"/></button><view wx:if="{{section === 'help'}}" class="reveal"><view class="sub">未开启同步的资料仅保存在本机，清理小程序数据可能丢失。成绩不向共创成员公开。登录不获取手机号，头像和昵称由你主动选择、填写并保存，用于个人资料展示；共创活动使用你的显示昵称。旧助手资料可从成绩设置导入 JSON 备份。</view></view>
 </view>
 <view class="release-version">慧共创 · {{releaseVersion}}</view>
</view>
