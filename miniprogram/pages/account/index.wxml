<app-nav title="{{view === 'settings' ? '账号设置' : view === 'points' ? '点数明细' : view === 'articles' ? '共创文章' : '我的'}}" show-back="{{true}}" custom-back="{{true}}" bindback="back" bindhome="home"/>
<view class="account">
 <block wx:if="{{view === 'main'}}">
 <view class="identity-card"><view class="avatar" role="button" bindtap="{{user ? 'editProfile' : 'signIn'}}" aria-label="设置头像和昵称"><image wx:if="{{user.avatarUrl && !avatarBroken}}" src="{{user.avatarUrl}}" mode="aspectFill" binderror="avatarError"/><text wx:else>{{user ? (user.name ? user.name[0] : '我') : '访'}}</text></view><view class="identity-copy"><view class="identity-name">{{user ? (user.name || '微信用户') : '访客'}}</view><view wx:if="{{!user}}" class="sub">本机记录</view></view><button wx:if="{{!user}}" class="login-pill" bindtap="signIn">登录</button><button wx:else class="login-pill" bindtap="editProfile">编辑</button></view>
 <view wx:if="{{error}}" class="error">{{error}}</view>
 <view wx:if="{{user}}" class="points-banner"><view class="points-highlight"><text class="sub">可用点数</text><text class="points-balance">{{user.balance >= 0 ? user.balance : '—'}}</text><text>点</text></view><button class="small-link" bindtap="openPoints">点数明细<ui-icon name="chevron-right" size="20px"/></button></view>
 <view wx:if="{{user.frozen > 0}}" class="sub frozen-note">冻结 {{user.frozen}} 点</view>
 <button class="menu-row" bindtap="openArticles"><text>共创文章</text><view class="row-state"><text>{{articlesLoading ? '…' : articleCount === null ? '—' : articleCount}}</text><ui-icon name="chevron-right" size="20px"/></view></button>
 <button class="menu-row" bindtap="grades"><text>成绩记录</text><view class="row-state"><text>{{sync.count || 0}}</text><ui-icon name="chevron-right" size="20px"/></view></button>
 <button class="menu-row" bindtap="openSettings"><text>账号设置</text><ui-icon name="chevron-right" size="20px"/></button>
 <view class="account-footer"><button class="support-link" open-type="contact" binderror="supportError">客服服务</button><text>慧共创 · {{releaseVersion}}</text></view>
 </block>
 <block wx:elif="{{view === 'settings'}}"><view wx:if="{{error}}" class="error">{{error}}</view> <view class="menu-group">
 <button class="menu-row" data-section="students" bindtap="toggle"><text>学生管理</text><ui-icon name="{{section === 'students' ? 'chevron-up' : 'chevron-down'}}" size="20px"/></button><view wx:if="{{section === 'students'}}" class="reveal"><view class="reveal-title">切换学生</view><button wx:for="{{students}}" wx:key="id" data-id="{{item.id}}" bindtap="selectStudent" disabled="{{busy}}" class="student-option {{active === item.id ? 'selected' : ''}}">{{item.name}} <ui-icon wx:if="{{active === item.id}}" name="check" tone="accent" size="20px"/></button><input value="{{studentName}}" data-field="studentName" bindinput="input" maxlength="30" placeholder="新学生称呼" placeholder-class="input-placeholder" placeholder-style="font-size:15px;font-weight:400;color:#65736B"/><button bindtap="addStudent" disabled="{{busy || !studentName}}">添加学生</button></view>
 <button class="menu-row" data-section="sync" bindtap="toggle"><text>云端同步</text><view class="row-state"><text class="row-meta">{{sync.enabled ? '已开启' : '未开启'}}</text><ui-icon name="{{section === 'sync' ? 'chevron-up' : 'chevron-down'}}" size="20px"/></view></button>
 <view wx:if="{{section === 'sync'}}" class="reveal"><view class="sub">{{user ? '为当前学生保存到账号，换设备也能继续。' : '登录后可为当前学生开启同步。'}}</view><view class="error" wx:if="{{sync.error}}">{{sync.error}}</view><button wx:if="{{!user}}" class="primary" bindtap="signIn">登录账号</button><block wx:else><button wx:if="{{!sync.enabled}}" class="primary" bindtap="enableSync" disabled="{{busy}}" loading="{{busy}}">开启同步</button><block wx:else><button wx:if="{{!sync.conflict}}" class="primary" bindtap="syncNow" disabled="{{busy}}" loading="{{busy}}">立即同步</button><block wx:else><view class="reveal-title">对比后选择要保留的完整版本</view><view class="conflict-versions"><view class="conflict-version"><view class="h2">本机版本</view><view>{{conflictSummary.local.records}} 次考试 · {{conflictSummary.local.plans}} 项复盘</view><view class="sub">考试最近修改：{{conflictSummary.local.updated}}</view></view><view class="conflict-version"><view class="h2">云端版本</view><view>{{conflictSummary.remote.records}} 次考试 · {{conflictSummary.remote.plans}} 项复盘</view><view class="sub">考试最近修改：{{conflictSummary.remote.updated}}</view></view></view><view wx:for="{{conflictSummary.changes}}" wx:key="id" class="conflict-change"><view>{{item.label}}</view><view class="sub">{{item.detail}}</view></view><view wx:if="{{conflictSummary.otherChanged}}" class="sub">草稿、设置或参照数据也存在差异。</view><view class="sub">选择后将采用该版本的全部资料，包括删除差异，不会自动合并。双方内容会先保存到本机“历史备份”。</view><button data-choice="local" bindtap="resolveConflict" disabled="{{busy}}">保留本机版本</button><button data-choice="remote" bindtap="resolveConflict" disabled="{{busy}}">采用云端版本</button></block><button bindtap="stopSync" disabled="{{busy}}">暂停同步</button></block></block></view>
 <block><button class="menu-row" data-section="import" bindtap="toggle"><text>导入本机记录</text><ui-icon name="{{section === 'import' ? 'chevron-up' : 'chevron-down'}}" size="20px"/></button><view wx:if="{{section === 'import'}}" class="reveal"><view class="sub">导入到当前学生，原记录会保留。</view><view wx:if="{{!guestStudents.length}}" class="sub">暂无可导入的游客记录</view><button wx:for="{{guestStudents}}" wx:key="id" data-id="{{item.id}}" bindtap="importGuest" disabled="{{busy}}">{{item.name}} · {{item.count}} 次考试　导入</button></view></block>
 <block wx:if="{{backups.length}}"><button class="menu-row" data-section="backups" bindtap="toggle"><text>历史备份</text><ui-icon name="{{section === 'backups' ? 'chevron-up' : 'chevron-down'}}" size="20px"/></button><view wx:if="{{section === 'backups'}}" class="reveal"><button wx:for="{{backups}}" wx:key="id" data-id="{{item.id}}" bindtap="restoreBackup" disabled="{{busy}}">{{item.time}} · 恢复</button></view></block>
 <button class="menu-row" data-section="coCreateHelp" bindtap="toggle"><text>共创使用说明</text><ui-icon name="{{section === 'coCreateHelp' ? 'chevron-up' : 'chevron-down'}}" size="20px"/></button><view wx:if="{{section === 'coCreateHelp'}}" class="reveal"><view class="sub">创建活动后分享邀请，成员可以提交文字和照片。</view><view class="sub">发起人和协作者可整理素材、生成和编辑文章。协作者使用 AI 需获得授权，消耗发起人的点数。</view><view class="sub">创建活动、收集资料、手工编辑和定稿免费，AI 任务确认费用后才启动。</view><view class="sub">文章定稿后可分享链接，也可在电脑打开链接，复制正文到公众号后台发布。</view></view>
 <button class="menu-row" data-section="help" bindtap="toggle"><text>数据与隐私</text><ui-icon name="{{section === 'help' ? 'chevron-up' : 'chevron-down'}}" size="20px"/></button><view wx:if="{{section === 'help'}}" class="reveal"><view class="sub">未开启同步的资料仅保存在本机，清理小程序数据可能丢失。成绩不向共创成员公开。登录不获取手机号，头像和昵称由你主动选择、填写并保存，用于个人资料展示；共创活动使用你的显示昵称。旧助手资料可从成绩设置导入 JSON 备份。</view></view>
 <button wx:if="{{user}}" class="logout-row" bindtap="logout" disabled="{{busy}}"><ui-icon name="logout" size="20px"/><text>退出账号</text></button>
 </view>
</block>
 <block wx:elif="{{view === 'points'}}"><view wx:if="{{section === 'points'}}" class="points-details"><view wx:if="{{pointsLoading}}" class="sub" aria-live="polite">正在读取点数明细…</view><view wx:if="{{pointsError}}" class="error">{{pointsError}}<button bindtap="retryPoints" disabled="{{pointsLoading}}">重试</button></view><view wx:if="{{!ledger.length && !pointsLoading && !pointsError}}" class="sub">暂无点数记录</view><button wx:for="{{ledger}}" wx:key="id" class="ledger-row" data-index="{{index}}" bindtap="pointDetail"><view class="ledger-copy"><view>{{item.label}}</view><view class="sub">{{item.time}}</view></view><text>{{item.amount > 0 ? '+' : ''}}{{item.amount}}</text></button><button wx:if="{{hasMorePoints}}" bindtap="morePoints" loading="{{pointsLoading}}" disabled="{{pointsLoading}}">加载更多</button><view class="sub">点数不足可联系运营者补充。</view></view></block>
 <block wx:elif="{{view === 'articles'}}"><view wx:if="{{articlesLoading}}" class="sub">正在加载文章…</view><view wx:if="{{articlesError}}" class="error">{{articlesError}}<button bindtap="loadArticles">重试</button></view><view wx:if="{{!articlesLoading && !articlesError && !articles.length}}" class="sub">暂无可阅读的共创文章</view><button wx:for="{{articles}}" wx:key="activityId" class="menu-row" data-id="{{item.activityId}}" bindtap="openArticle"><view class="article-summary"><view>{{item.title}}</view><view class="sub">{{item.activityName}}</view></view><ui-icon name="chevron-right" size="20px"/></button></block>
</view>
