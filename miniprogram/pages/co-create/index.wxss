/* 线描主题：同一套色彩、间距和文字层级覆盖活动内所有状态。 */
.page{padding:24px 20px calc(32px + env(safe-area-inset-bottom));font-size:16px;line-height:1.6}
.page.with-composer{padding-bottom:calc(230px + env(safe-area-inset-bottom))}
.page button{display:flex;align-items:center;justify-content:center;gap:8px;width:100%;max-width:none;min-height:48px;margin:0;padding:12px 16px;border:1px solid var(--ui-line);border-radius:10px;background:var(--ui-surface);color:var(--ui-green);font-size:16px;line-height:1.5;font-weight:500;white-space:normal;text-align:center}
.page button+button{margin-top:12px}.page button.primary{background:var(--ui-green);border-color:var(--ui-green);color:#fff}.page .link{width:auto;min-height:44px;padding:10px 4px;border:0;background:transparent;font-size:15px}
.page .h1{font-size:22px;line-height:1.4;font-weight:600;margin-bottom:16px;overflow-wrap:break-word}.page .h2{font-size:19px;line-height:1.45;font-weight:600;margin-bottom:12px;overflow-wrap:break-word}.page .hint{font-size:15px;color:var(--ui-muted);line-height:1.6;margin:8px 0}.page .center{text-align:center}
.page .card{background:var(--ui-surface);border:1px solid var(--ui-line);border-radius:16px;padding:20px;margin-bottom:16px;overflow:hidden;box-shadow:none}
.page .heading,.page .row{display:flex;align-items:center;gap:12px;min-width:0}.page .heading{justify-content:space-between;margin-bottom:16px}.page .heading>.h1,.page .heading .hint{margin:0}.page .heading>view:first-child{min-width:0}.page .heading button,.page .row button{flex:0 0 auto;width:auto;margin:0}
.page .badge{display:inline-block;padding:3px 8px;border:1px solid var(--ui-green-line);border-radius:6px;background:var(--ui-green-soft);color:var(--ui-green);font-size:15px;line-height:1.5;white-space:nowrap}
.page .home-heading{margin:0 0 20px;align-items:center;flex-wrap:wrap}.page .home-heading .h1{font-size:22px}.page .home-heading .row{gap:8px}.page .home-heading button{min-height:44px;padding:10px 14px;font-size:15px}
.page .activity{padding:18px 0;border:0;border-bottom:1px solid var(--ui-line);background:transparent;border-radius:0;margin:0}.page .activity .heading{margin:0 0 12px}.page .activity .h2{margin:0;font-size:19px}.page .description{color:var(--ui-muted);font-size:16px;line-height:1.7;margin:8px 0;white-space:pre-wrap;overflow-wrap:break-word}.page .activity .description{display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.page .card-footer{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:8px;margin-top:12px;font-size:15px;color:var(--ui-muted)}.card-action{display:flex;align-items:center;gap:4px;color:var(--ui-green)}.article-state{font-size:15px;color:var(--ui-muted);margin-top:8px}
.page .filters{width:100%;white-space:nowrap;margin:0 0 12px;border-bottom:1px solid var(--ui-line-soft)}.page .filters button{display:inline-flex;width:auto;min-height:44px;padding:10px 12px;margin:0 4px 8px 0;border:1px solid transparent;background:transparent;font-size:15px;border-radius:8px;color:var(--ui-muted)}.page .filters .selected{background:var(--ui-green-soft);border-color:var(--ui-green-line);color:var(--ui-green);font-weight:600}
.page .empty{padding:48px 12px;text-align:center;color:var(--ui-muted);font-size:16px;line-height:1.8}.page .empty .h1{color:var(--ui-ink)}.page .empty button{margin:24px auto 0;max-width:280px}
.page .field{margin-bottom:24px;font-size:16px;font-weight:500}.page input,.page textarea,.page .select-row{display:block;width:100%;margin-top:8px;border:1px solid var(--ui-line);border-radius:10px;background:var(--ui-surface);color:var(--ui-ink);font-size:16px;font-weight:400;line-height:1.6;padding:12px}.page input{height:48px}.page textarea{height:128px}.page .select-row{display:flex;align-items:center;justify-content:space-between;gap:12px;min-height:48px}
.page .notice{padding:12px;border:1px solid #E8DBC6;border-radius:10px;background:var(--ui-warn-soft);color:var(--ui-warn);font-size:15px;line-height:1.7;margin:12px 0}.page .error{padding:12px;background:var(--ui-danger-soft);color:var(--ui-danger);border:1px solid #E9CEC6;border-radius:10px;margin-bottom:16px;font-size:15px;overflow-wrap:break-word}.page .error .link{color:var(--ui-danger);justify-content:flex-start;padding-left:0}.page .loading{text-align:center;color:var(--ui-muted);padding:20px;font-size:15px}
.page .consent{display:flex;align-items:center;flex-wrap:wrap;gap:4px;font-size:15px;margin:16px 0;min-height:44px}.page checkbox{transform:scale(.8);flex-shrink:0}.page .prose text{display:block;white-space:pre-wrap;font-size:16px;line-height:1.85}.page .prose>view{margin:16px 0}.page .invite-code{font-size:32px;font-weight:600;letter-spacing:5px;margin:24px 0}.page .qr-image{display:block;width:220px;max-width:100%;margin:16px auto}
.page .activity-header{margin-bottom:12px}.page .activity-header .h1{font-size:22px;margin:0 0 4px}.page .activity-meta{display:flex;align-items:center;justify-content:space-between;gap:12px}.page .activity-meta .link{font-size:15px;padding:8px 0}
.page .activity-tabs{display:flex;border-bottom:1px solid var(--ui-line);margin:0 0 16px}.page .activity-tabs button{flex:1;width:0;min-width:0;min-height:48px;margin:0;padding:12px 0;border:0;border-bottom:2px solid transparent;border-radius:0;background:transparent;color:var(--ui-muted);font-size:16px}.page .activity-tabs button.selected{border-bottom-color:var(--ui-green);color:var(--ui-green);font-weight:600}
.page .task-link{justify-content:space-between;width:100%;padding:12px;background:var(--ui-blue-soft);color:var(--ui-blue);border-radius:10px;margin-bottom:16px}
.page .message{display:flex;gap:12px;margin:24px 0}.page .avatar{display:flex;align-items:center;justify-content:center;width:32px;height:32px;background:var(--ui-green-soft);color:var(--ui-green);border:1px solid var(--ui-green-line);border-radius:50%;font-size:15px;flex-shrink:0}.page .message-body{min-width:0;flex:1}.page .message-meta{display:flex;align-items:center;justify-content:space-between;gap:8px;font-size:15px;color:var(--ui-muted);margin:0 0 8px}.page .message-meta>text:first-child{overflow:hidden;white-space:nowrap;text-overflow:ellipsis}.page .message-meta>text:last-child{flex-shrink:0}.page .bubble{padding:12px 14px;background:var(--ui-surface);border:1px solid var(--ui-line);border-radius:0 12px 12px 12px;font-size:16px;line-height:1.7;overflow-wrap:break-word;white-space:pre-wrap}.page .message-body>.link{justify-content:flex-start;color:var(--ui-muted);padding:8px 0}.page .photos{display:flex;flex-wrap:wrap;gap:8px}.page .photos image{width:140rpx;height:140rpx;border-radius:8px;margin-top:8px}.page .withdrawn{font-size:15px;color:var(--ui-muted);padding:8px 0}
.page .composer{position:fixed;z-index:20;left:0;right:0;bottom:0;padding:12px 20px calc(12px + env(safe-area-inset-bottom));background:var(--ui-bg);border-top:1px solid var(--ui-line)}.page .composer.keyboard-open{padding-bottom:12px}.page .composer textarea{margin:0;background:var(--ui-surface);height:60px;min-height:60px;max-height:120px;padding:12px}.page .composer .heading{margin:8px 0 0}.page .composer .heading .primary{min-width:72px;min-height:44px;padding:10px 20px}.page .composer .hint,.page .composer .error{margin:8px 0}.page .link.icon-label{display:flex;align-items:center;gap:8px}
.page .pending{display:flex;flex-wrap:nowrap;gap:8px;overflow-x:auto;margin-top:8px}.page .pending>view{width:52px;flex-shrink:0}.page .pending image{width:52px;height:52px;border-radius:6px}.page .pending .link{width:100%;font-size:15px;padding:4px}
.page .member{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:16px 0;min-height:64px;border-bottom:1px solid var(--ui-line-soft)}.page .member:last-child{border:0}.page .member .hint{margin:4px 0 0}
.page .setting-row{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px;width:100%;min-height:56px;padding:16px 0;border:0;border-bottom:1px solid var(--ui-line-soft);border-radius:0;background:transparent;color:var(--ui-ink);text-align:left;font-size:16px;font-weight:400}.page .setting-row:last-child{border:0}.page .setting-row+button{margin-top:0}.page .setting-value{display:flex;align-items:center;gap:8px;color:var(--ui-muted);font-size:15px;flex-shrink:0}
.page .material-text{margin:16px 0;font-size:16px;line-height:1.8;overflow-wrap:break-word;white-space:pre-wrap}.page .material-toolbar{margin-bottom:16px;flex-wrap:wrap;gap:12px}.page .material-toolbar button{font-size:15px;padding:10px 12px}.page .material-card .heading label{display:flex;align-items:center}.page .material-card .select-row{font-size:15px;background:var(--ui-green-soft);color:var(--ui-green);border-color:var(--ui-green-line)}
.page .article-paper{padding:20px 0;margin:12px 0;background:transparent}.page .article-paper .h1{font-size:22px;line-height:1.5}.page .paragraph{display:block;white-space:pre-wrap;overflow-wrap:break-word;line-height:1.85;margin:16px 0;font-size:17px}.page .article-image{display:block;width:100%;margin:16px 0;border-radius:10px}.page .caption{text-align:center;font-size:15px;color:var(--ui-muted)}
.page.with-article-dock{padding-bottom:calc(116px + env(safe-area-inset-bottom))}
.page .article-review-panel{margin:24px 0 0;padding:0 16px;border:1px solid var(--ui-line);border-radius:12px;background:var(--ui-surface)}
.page .article-review-check{display:flex;align-items:center;gap:6px;min-height:60px;padding:12px 0;font-size:15px;line-height:1.6;color:var(--ui-secondary)}.page .article-review-check text{flex:1;min-width:0}
.page .article-visibility{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:14px 0;border-top:1px solid var(--ui-line-soft)}.page .article-visibility:first-child{border-top:0}.page .visibility-title{font-size:16px;line-height:1.5}.page .article-visibility .hint{margin:3px 0 0;font-size:15px}.page .article-visibility switch{flex:none;transform:scale(.86);transform-origin:right center}
.page .article-dock{position:fixed;left:0;right:0;bottom:0;z-index:25;display:flex;align-items:center;gap:10px;margin:0;padding:12px 20px calc(12px + env(safe-area-inset-bottom));background:var(--ui-bg);border-top:1px solid var(--ui-line)}
.page .article-dock button{font-size:15px;min-height:48px;margin:0;padding:12px 10px;white-space:nowrap}.page .article-dock .article-more{flex:none;flex-direction:column;gap:0;width:44px;padding:0;border:0;background:transparent;font-size:15px}.page .article-dock .edit-action{flex:1;width:0;min-width:0;margin:0}.page .article-dock .finalize-action{flex:1.15;width:0;min-width:0;margin:0}
.page .body-editor{height:420px;line-height:1.9}
.page .profile-card{padding:20px;background:var(--ui-green-soft);border-color:var(--ui-green-line)}.page .profile-card .heading{margin:0}.page .balance-number{font-size:32px;font-weight:600;line-height:1.2;color:var(--ui-green)}.page .balance-summary{display:flex;align-items:baseline;gap:8px;margin-bottom:8px}.page .quiet-button{background:transparent;color:var(--ui-muted)}
.page>button.disclosure-row{display:flex;align-items:center;justify-content:space-between;width:100%;min-height:48px;padding:12px 0;margin:0 0 16px;border:0;border-bottom:1px solid var(--ui-line);border-radius:0;background:transparent;color:var(--ui-ink);font-size:16px;font-weight:400;text-align:left}
.collab-empty{margin:24px 0;padding:40px 0;text-align:center}.collab-symbol{display:flex;align-items:center;justify-content:center;margin:0 auto 16px;width:56px;height:56px;border:1px solid var(--ui-green-line);border-radius:16px;background:var(--ui-green-soft)}.collab-title{font-size:19px;font-weight:600;margin-bottom:20px}.collab-empty .demo-disclosure{font-size:15px;background:transparent;border:0;color:var(--ui-green);margin-top:8px}.nav-account{font-size:15px;line-height:24px;min-height:44px;display:flex;align-items:center;padding:10px 4px;color:var(--ui-green)}

.page .generation-layout-option{margin:20px 0 24px}.page .generation-layout-label{display:flex;align-items:flex-start;gap:8px;min-height:52px;font-size:16px;color:var(--ui-ink)}.page .generation-layout-label checkbox{margin-top:0;flex:none}.page .generation-layout-label .hint{margin-top:4px;font-weight:400}.page .generation-estimate{margin:12px 0 16px;min-height:26px;font-size:17px;font-weight:600;color:var(--ui-ink)}.page .generation-estimate .hint{font-weight:400}

/* Task guidance and quote hierarchy */
.next-step .h2{margin:6px 0 8px}.next-step button{margin-top:12px}.quote-summary{margin:12px 0;line-height:1.7;overflow-wrap:break-word}.quote-limit{font-size:22px;font-weight:600;color:var(--ui-green);margin:16px 0 8px;line-height:1.5}

.editor-toolbar{background:var(--ui-bg);border-bottom:1px solid var(--ui-line);padding:12px 0;margin-bottom:16px}.editor-actions{display:flex;flex-wrap:wrap;gap:12px;margin-top:8px}.page .editor-actions button{flex:1;min-width:100px;margin:0;min-height:44px}.refresh-status{font-size:15px;color:var(--ui-muted);line-height:1.6;padding:8px 0}.page .body-editor{height:55vh;min-height:280px}.page button[disabled]{opacity:.55}

.page .activity-title-row{display:flex;align-items:flex-start;justify-content:space-between;gap:16px}.page .activity-title-row .h2{flex:1;min-width:0;line-height:1.5;overflow-wrap:break-word}.page .activity-title-row .badge{flex-shrink:0;margin-top:2px;white-space:nowrap}.page .activity-title-row .formed{background:var(--ui-blue-soft);color:var(--ui-blue);border-color:var(--ui-blue-line)}.page .activity .card-footer{justify-content:flex-start;gap:8px}.activity-role{display:inline-flex;align-items:center;gap:4px}.activity-role ui-icon{flex-shrink:0}
