<app-nav title="{{screen === 'home' ? '活动共创' : title}}" show-back="{{screen !== 'home'}}" custom-back="{{screen !== 'home'}}" bindback="back" bindhome="hub"></app-nav>
<view class="page {{screen === 'article' && article && activity.manager ? 'with-article-dock' : ''}} {{screen === 'stream' && activity.status === 'collecting' ? 'with-composer' : ''}}">

 <view wx:if="{{error}}" class="error"><text>{{error}}</text><button class="link" bindtap="retry">重试</button></view>
 <view wx:if="{{loading}}" class="loading" aria-live="polite">正在加载…</view><view wx:elif="{{refreshing}}" class="refresh-status" aria-live="polite">正在更新，现有内容可继续查看</view>
 <view wx:if="{{screen === 'privacy'}}" class="card prose"><view class="h2">隐私说明</view><text>微信身份标识用于关联账号，显示姓名仅用于展示。同名用户不会共享账号。\n\n活动文字和图片仅向有权限的成员展示；确认 AI 任务后，必要资料会发送给模型服务处理。\n\n公开文章通过主动分享的链接访问，管理者可关闭分享。撤回资料不会自动撤回已复制或发布到外部的内容。</text></view>
 <block wx:elif="{{screen === 'name'}}"><view class="h1">怎么称呼你？</view><view class="field">显示姓名<input value="{{name}}" maxlength="30" placeholder="真实姓名或常用称呼" data-field="name" bindinput="input" placeholder-class="input-placeholder" placeholder-style="font-size:15px;font-weight:400;color:#65736B"/></view><button class="primary" loading="{{busy}}" disabled="{{busy}}" bindtap="saveName">保存</button></block>
 <block wx:elif="{{screen === 'home'}}">
  <view class="heading home-heading"><text class="h1">共创活动</text><view class="row"><button data-screen="join" bindtap="navigate">加入</button><button class="primary" data-screen="create" bindtap="navigate"><ui-icon name="add" size="18px" tone="on-accent"/><text>创建</text></button></view></view>

  <scroll-view wx:if="{{user}}" scroll-x class="filters"><button wx:for="{{filters}}" wx:key="*this" class="{{filter === item ? 'selected' : ''}}" data-value="{{item}}" bindtap="setFilter">{{item}}</button></scroll-view>
  <view wx:if="{{!loading && !activities.length && !error}}" class="collab-empty"><view class="collab-symbol"><ui-icon name="paper" size="28px"/></view><view class="collab-title">暂无共创活动</view><button class="primary" data-screen="create" bindtap="navigate">创建活动</button><button class="demo-disclosure" bindtap="demo"><text>查看成文示例</text><ui-icon name="chevron-right" size="18px"/></button></view>
  <view wx:for="{{activities}}" wx:key="id" class="card activity" data-id="{{item.id}}" bindtap="openActivity" role="button" aria-label="{{item.name}}，{{item.displayStatus}}"><view class="activity-title-row"><view class="h2">{{item.name}}</view><text class="badge {{item.formed ? 'formed' : ''}}">{{item.displayStatus}}</text></view><view wx:if="{{item.description}}" class="description">{{item.description}}</view><view class="card-footer"><view class="activity-role"><ui-icon name="{{item.roleIcon}}" size="16px"/><text>{{item.roleText}}</text></view><text>{{item.memberCount}} 人</text><text>·</text><text>{{item.materialCount}} 份资料</text></view><view wx:if="{{item.articleStatus === 'draft' || (item.taskText && item.latestTask.stage !== 'succeeded')}}" class="article-state"><text wx:if="{{item.articleStatus === 'draft'}}">草稿待核对</text><text wx:if="{{item.taskText && item.latestTask.stage !== 'succeeded'}}">{{item.articleStatus === 'draft' ? ' · ' : ''}}AI {{item.taskText}}</text></view></view>
 </block>
 <block wx:elif="{{screen === 'demo'}}"><view class="card prose"><view class="hint">演示内容 · 以下人物与活动均为虚构</view><view class="h1">一起寻找校园里的秋天</view><view>周五下午，同学们带着观察卡走进校园。有人记录树叶的颜色，有人画下花坛的轮廓，还有人把发现写成一段小诗。</view><view>分享时，大家把各自的观察贴在同一张海报上。原来，每个人眼中的秋天都不一样，汇在一起就成了一段完整的班级记忆。</view><view class="h2">这篇文章怎样共创？</view><view>发起人提出活动主题，成员分别提交观察文字和照片；整理者挑选素材，生成草稿后核对事实，再决定是否分享。</view><button class="primary" data-screen="create" bindtap="navigate">创建我的共创活动</button></view></block>
 <block wx:elif="{{screen === 'create' || screen === 'info'}}"><view class="field">活动名称 *<input value="{{name}}" maxlength="80" data-field="name" bindinput="input" placeholder="填写活动名称" placeholder-class="input-placeholder" placeholder-style="font-size:15px;font-weight:400;color:#65736B"/></view><button class="disclosure-row" data-section="activityDescription" bindtap="toggleSection"><text>活动说明</text><ui-icon name="{{expanded.activityDescription ? 'chevron-up' : 'chevron-down'}}" size="20px"/></button><view wx:if="{{expanded.activityDescription}}" class="field"><textarea value="{{description}}" maxlength="2000" data-field="description" bindinput="input" placeholder="介绍活动内容或资料要求（选填）" placeholder-class="input-placeholder" placeholder-style="font-size:15px;font-weight:400;color:#65736B"/></view><button wx:if="{{screen === 'create'}}" class="primary" bindtap="create" loading="{{busy}}" disabled="{{busy}}">创建活动</button><button wx:else class="primary" bindtap="saveInfo" loading="{{busy}}" disabled="{{busy}}">保存</button></block>
 <block wx:elif="{{screen === 'created'}}"><view class="empty"><view class="h1">活动已创建</view><text>{{activity.name}}</text></view><button class="primary" data-screen="invite" bindtap="navigate">邀请参与者</button><button data-screen="stream" bindtap="navigate">进入活动</button></block>
 <block wx:elif="{{screen === 'join'}}"><view class="field">六位邀请码<input value="{{inviteCode}}" data-field="inviteCode" bindinput="input" maxlength="6" type="number" placeholder="请输入邀请码" placeholder-class="input-placeholder" placeholder-style="font-size:15px;font-weight:400;color:#65736B"/></view><button class="primary" bindtap="checkInvite" loading="{{busy}}" disabled="{{busy}}">查看活动</button></block>
 <block wx:elif="{{screen === 'invitation'}}"><view class="card"><view class="h1">{{invite.name}}</view><view class="description">{{invite.description}}</view><text class="badge">{{invite.statusText}}</text><view class="hint">{{invite.memberCount}} 位成员</view><view wx:if="{{invite.status === 'paused'}}" class="notice">活动暂停收集，加入后可查看，暂不能提交。</view><view wx:if="{{invite.status === 'archived'}}" class="notice">活动已归档，暂不接受新成员。</view><button wx:else class="primary" bindtap="join" loading="{{busy}}" disabled="{{busy}}">{{invite.joined ? '进入活动' : '确认加入'}}</button></view></block>
 <block wx:elif="{{screen === 'invite'}}"><view class="card center"><view class="h2">{{activity.name}}</view><view class="hint">邀请码</view><view class="invite-code">{{activity.inviteCode}}</view><button class="primary" bindtap="copyInvite">复制邀请码</button><button open-type="share">分享活动给微信好友</button><button bindtap="showQr" loading="{{busy}}">活动二维码</button><image wx:if="{{qrImage}}" class="qr-image" src="{{qrImage}}" show-menu-by-longpress mode="widthFix"/></view></block>
 <block wx:elif="{{screen === 'stream' || screen === 'materials' || screen === 'article' || screen === 'settings'}}">
  <view class="activity-header"><view class="h1">{{activity.name}}</view><view class="activity-meta"><text class="badge">{{activity.displayStatus}}</text><button class="link" data-screen="members" bindtap="navigate"><text>{{activity.memberCount}} 位成员</text><ui-icon name="chevron-right" size="18px"/></button></view></view>
  <view class="activity-tabs"><button class="{{screen === 'stream' ? 'selected' : ''}}" data-screen="stream" bindtap="navigate">资料</button><button wx:if="{{activity.manager}}" class="{{screen === 'materials' ? 'selected' : ''}}" data-screen="materials" bindtap="navigate">选材</button><button class="{{screen === 'article' ? 'selected' : ''}}" data-screen="article" bindtap="navigate">文章</button><button wx:if="{{activity.manager}}" class="{{screen === 'settings' ? 'selected' : ''}}" data-screen="settings" bindtap="navigate">管理</button></view>
  <block wx:if="{{screen === 'stream'}}">
   <view wx:if="{{activity.manager && !loading && !error}}" class="card next-step" aria-live="polite"><view class="hint">下一步</view>
    <block wx:if="{{activity.latestTask.stage === 'queued' || activity.latestTask.stage === 'vision' || activity.latestTask.stage === 'writing' || activity.latestTask.stage === 'review'}}"><view class="h2">AI 任务正在处理</view><view class="hint">可以继续查看资料，稍后回来查看结果。</view><button class="primary" bindtap="taskPage">查看任务进度</button></block>
    <block wx:elif="{{activity.status === 'archived'}}"><view class="h2">活动已归档</view><view class="hint">可查看已收集的资料和文章。</view><button data-screen="article" bindtap="navigate">查看文章</button></block>
    <block wx:elif="{{activity.articleStatus === 'final' || activity.articleStatus === 'published'}}"><view class="h2">文章已定稿，可以分享</view><button class="primary" data-screen="article" bindtap="navigate">查看文章与分享</button></block>
    <block wx:elif="{{activity.articleStatus === 'draft'}}"><view class="h2">草稿已就绪，请核对内容</view><view class="hint">核对活动事实和配图后，再确认定稿。</view><button class="primary" data-screen="article" bindtap="navigate">核对草稿</button></block>
    <block wx:elif="{{activity.materialCount > 0}}"><view class="h2">已收集 {{activity.materialCount}} 份资料</view><view class="hint">先整理选材，再生成文章草稿。</view><button class="primary" data-screen="materials" bindtap="navigate">整理素材</button></block>
    <block wx:else><view class="h2">{{activity.status === 'paused' ? '活动已暂停收集' : '邀请成员，一起收集资料'}}</view><view class="hint">{{activity.status === 'paused' ? '恢复收集后，成员才能提交文字和照片。' : '成员可通过邀请码或微信分享加入活动。'}}</view><button class="primary" data-screen="{{activity.status === 'paused' ? 'settings' : 'invite'}}" bindtap="navigate">{{activity.status === 'paused' ? '管理收集状态' : '邀请参与者'}}</button></block>
   </view>
   <button wx:if="{{newCount}}" class="link" bindtap="latest">有新资料，点击查看</button><view wx:if="{{activity.announcement}}" class="notice">{{activity.announcement}}</view><button wx:if="{{activity.manager && (activity.latestTask || task.activityId === activity.id)}}" class="link task-link" bindtap="taskPage"><text>{{activity.latestTask.stage === 'succeeded' ? '查看生成结果' : activity.latestTask.stage === 'failed' ? '查看失败原因' : '查看生成进度'}}</text><ui-icon name="chevron-right" size="18px"/></button>
   <button wx:if="{{hasMore}}" class="link" bindtap="history" disabled="{{busy}}">加载历史资料</button>
   <view wx:if="{{!materials.length && !loading && !error}}" class="empty">还没有资料，发送文字或照片开始记录。</view>
   <view wx:for="{{materials}}" wx:key="id" class="message"><view class="avatar">{{item.initial}}</view><view class="message-body"><view class="message-meta"><text>{{item.name}}</text><text>{{item.time}}</text></view><view wx:if="{{item.withdrawn}}" class="withdrawn">该资料已撤回</view><block wx:else><view class="bubble"><text user-select>{{item.text}}</text><view class="photos"><image wx:for="{{item.images}}" wx:for-item="photo" wx:key="path" src="{{photo.url}}" mode="aspectFill" lazy-load data-url="{{photo.url}}" data-urls="{{item.imageUrls}}" bindtap="previewPhoto"/></view></view><button wx:if="{{item.own && activity.writable}}" class="link" data-id="{{item.id}}" bindtap="withdraw">撤回</button></block></view></view><view id="latest-message"/>
   <view wx:if="{{activity.status === 'collecting'}}" class="composer {{keyboardHeight ? 'keyboard-open' : ''}}" style="bottom:{{keyboardHeight}}px"><textarea adjust-position="{{false}}" bindkeyboardheightchange="keyboardChange" value="{{message}}" maxlength="5000" data-field="message" bindinput="input" disabled="{{busy || sendError}}" placeholder="填写文字或照片说明" placeholder-class="input-placeholder" placeholder-style="font-size:15px;font-weight:400;color:#65736B"/><view wx:if="{{photos.length}}" class="pending"><view wx:for="{{photos}}" wx:key="path"><image src="{{item.path}}" mode="aspectFill" data-url="{{item.path}}" bindtap="previewPhoto"/><button wx:if="{{!busy && !sendError}}" class="link" data-index="{{index}}" bindtap="removePhoto">移除</button></view></view><view wx:if="{{sendError}}" class="error">{{sendError}}，输入与照片已保留。</view><view wx:if="{{progress}}" class="hint">{{progress}}</view><view class="heading"><button class="link icon-label" bindtap="choosePhotos" disabled="{{busy || sendError}}"><ui-icon name="photo" size="20px"/><text>添加照片</text></button><button class="primary" bindtap="send" loading="{{busy}}" disabled="{{busy}}">{{sendError ? '重试发送' : '发送'}}</button></view></view><view wx:else class="notice">{{activity.status === 'archived' ? '活动已归档，资料只读。' : '已暂停收集，暂时不能提交资料。'}}</view>
  </block>
  <block wx:if="{{screen === 'materials'}}">
   <view wx:if="{{!activity.writable}}" class="notice">活动已归档，素材只读。</view>
   <scroll-view wx:if="{{user}}" scroll-x class="filters"><button wx:for="{{materialFilters}}" wx:key="*this" class="{{materialFilter === item ? 'selected' : ''}}" data-value="{{item}}" bindtap="setMaterialFilter">{{item}}</button></scroll-view>
   <view class="heading material-toolbar"><text class="hint">已选 {{checked.length}} 份</text><button bindtap="batchSelection" disabled="{{!activity.writable || busy}}">批量设置</button></view>
   <view wx:for="{{displayMaterials}}" wx:key="id" class="card material-card"><view class="heading"><checkbox-group data-id="{{item.id}}" bindchange="checkMaterial"><label><checkbox checked="{{item.checked}}" color="#285b4b"/>{{item.name}}</label></checkbox-group><text class="hint">{{item.stateText}}</text></view><view class="material-text">{{item.text}}</view><view class="photos"><image wx:for="{{item.images}}" wx:for-item="photo" wx:key="path" src="{{photo.url}}" mode="aspectFill" lazy-load data-url="{{photo.url}}" data-urls="{{item.imageUrls}}" bindtap="previewPhoto"/></view><picker range="{{choices}}" data-id="{{item.id}}" bindchange="setSelection" disabled="{{!activity.writable}}"><view class="select-row"><text>{{item.stateText}}</text><ui-icon name="chevron-down" size="18px"/></view></picker></view><view wx:if="{{!displayMaterials.length && !loading}}" class="empty">没有相关资料</view><button wx:if="{{hasMore}}" bindtap="moreMaterials" disabled="{{busy}}">加载更多</button><view wx:if="{{!activity.writable || !activity.aiAuthorized}}" class="hint">{{!activity.writable ? '活动已归档，恢复后可继续生成。' : '使用 AI 需发起人授权，仍可整理素材。'}}</view><button class="primary" bindtap="generate" disabled="{{!activity.writable || busy || !activity.aiAuthorized}}">生成草稿</button>
  </block>
  <block wx:if="{{screen === 'settings'}}">
   <view class="card"><button class="setting-row" bindtap="editInfo" disabled="{{!activity.writable}}"><text>活动信息</text><view class="setting-value"><text></text><ui-icon name="chevron-right" size="18px"/></view></button><button class="setting-row" bindtap="editAnnouncement" disabled="{{!activity.writable}}"><text>活动公告</text><view class="setting-value"><text></text><ui-icon name="chevron-right" size="18px"/></view></button><button class="setting-row" data-screen="members" bindtap="navigate"><text>成员与协作者</text><view class="setting-value"><text></text><ui-icon name="chevron-right" size="18px"/></view></button><button wx:if="{{activity.owner}}" class="setting-row" bindtap="collection"><text>收集状态</text><view class="setting-value"><text>{{activity.statusText}}</text><ui-icon name="chevron-right" size="18px"/></view></button><button class="setting-row" data-screen="invite" bindtap="navigate" disabled="{{!activity.writable}}"><text>邀请参与者</text><view class="setting-value"><text></text><ui-icon name="chevron-right" size="18px"/></view></button><button wx:if="{{activity.owner}}" class="setting-row" bindtap="resetInvite" disabled="{{!activity.writable}}"><text>重置邀请</text><view class="setting-value"><text></text><ui-icon name="chevron-right" size="18px"/></view></button></view>
  </block>
  <block wx:if="{{screen === 'article'}}">
   <view wx:if="{{!article && !loading && !error}}" class="empty">还没有文章<button wx:if="{{activity.manager}}" class="primary" bindtap="generate">生成草稿</button></view>
   <block wx:if="{{article}}"><view class="heading"><text class="badge">{{article.statusText}}</text><text class="hint">版本 {{article.revision}}</text></view><view wx:if="{{article.changed && activity.manager}}" class="notice">资料或活动信息已变化，请在定稿前核对。</view><view wx:if="{{activity.manager}}" class="card"><view class="h2">{{article.layout ? 'AI 专属排版' : '让 AI 为这篇文章做设计'}}</view><view class="hint">{{article.layout ? article.layout.summary : '根据内容决定配色、装饰和图文布局，保留原文。'}}</view><button bindtap="layoutArticle" disabled="{{!activity.writable || busy}}">{{article.layout ? '换一种设计' : 'AI 美化整篇'}}</button></view><view class="article-paper"><view class="h1">{{article.title}}</view><rich-text nodes="{{article.displayHtml}}" selectable /></view>
   <block wx:if="{{activity.manager}}">
    <view class="article-review-panel">
     <checkbox-group wx:if="{{article.status === 'draft' && activity.writable}}" bindchange="reviewed"><label class="article-review-check"><checkbox value="yes" checked="{{reviewed}}" color="#245d50"/><text>我已核对活动事实与资料变化</text></label></checkbox-group>
     <view class="article-visibility"><view><view class="visibility-title">对活动成员开放</view><view class="hint">{{visible ? '活动成员可阅读当前文章' : '仅管理者可查看当前文章'}}</view></view><switch checked="{{visible}}" color="#245d50" bindchange="memberVisibility" disabled="{{!activity.writable || busy}}"/></view>
    </view>
    <view class="article-tools article-dock">
     <button class="link article-more" bindtap="articleMore" aria-label="更多文章操作"><ui-icon name="ellipsis" size="20px"/><text>更多</text></button>
     <button class="edit-action" bindtap="editArticle" disabled="{{!activity.writable}}">编辑文章</button>
     <button wx:if="{{article.status === 'draft' && activity.writable}}" class="primary finalize-action" bindtap="finalize" disabled="{{busy}}">确认定稿</button>
     <button wx:if="{{article.status === 'final'}}" class="primary finalize-action" bindtap="sharePage">分享与发布</button>
    </view>
   </block></block>
  </block>
 </block>
 <block wx:elif="{{screen === 'members'}}"><view class="card"><view wx:for="{{members}}" wx:key="userId" class="member"><view><text>{{item.name}}</text><view class="hint">{{item.roleText}}{{item.ai && item.role === 'collaborator' ? ' · 已获 AI 授权' : ''}}</view></view><button wx:if="{{activity.owner && activity.writable && item.role !== 'owner'}}" class="link" data-index="{{index}}" bindtap="memberAction">管理</button></view></view><button wx:if="{{activity.manager && activity.writable}}" class="primary" data-screen="invite" bindtap="navigate">邀请参与者</button><view wx:if="{{activity.owner}}" class="hint">协作者默认没有消费点数权限，需单独授权。</view></block>
 <block wx:elif="{{screen === 'announcement'}}"><view class="field">活动公告<textarea value="{{announcement}}" maxlength="1000" data-field="announcement" bindinput="input"/></view><button class="primary" bindtap="saveAnnouncement" loading="{{busy}}" disabled="{{busy}}">保存</button></block>
 <block wx:elif="{{screen === 'generate'}}"><view class="field">选材方式<picker range="{{modes}}" value="{{modeIndex}}" data-field="modeIndex" bindchange="picker"><view class="select-row"><text>{{modes[modeIndex]}}</text><ui-icon name="chevron-down" size="18px"/></view></picker></view><button class="disclosure-row" data-section="generation" bindtap="toggleSection"><text>生成设置</text><ui-icon name="{{expanded.generation ? 'chevron-up' : 'chevron-down'}}" size="20px"/></button><view wx:if="{{expanded.generation}}"><view class="field">篇幅<picker range="{{lengths}}" value="{{lengthIndex}}" data-field="lengthIndex" bindchange="picker"><view class="select-row"><text>{{lengths[lengthIndex]}}</text><ui-icon name="chevron-down" size="18px"/></view></picker></view><view class="field">语气<picker range="{{tones}}" value="{{toneIndex}}" data-field="toneIndex" bindchange="picker"><view class="select-row"><text>{{tones[toneIndex]}}</text><ui-icon name="chevron-down" size="18px"/></view></picker></view><view class="field">重点（选填）<textarea value="{{focus}}" maxlength="500" data-field="focus" bindinput="input"/></view></view><checkbox-group class="generation-layout-option" bindchange="toggleGenerationLayout"><label class="generation-layout-label"><checkbox value="layout" checked="{{withLayout}}" color="#245D50"/><view><view>AI 美化排版</view><view class="hint">根据文章内容优化正文排版</view></view></label></checkbox-group><view class="generation-estimate" aria-live="polite"><text wx:if="{{estimateLoading}}" class="hint">正在预估点数…</text><text wx:elif="{{generationEstimate !== null}}">预计消耗 {{generationEstimate}} 点</text><text wx:else class="hint">{{estimateError || '确认费用后查看本次报价'}}</text></view><button class="primary" bindtap="quote" loading="{{busy}}" disabled="{{busy || estimateLoading}}">确认费用</button></block>
 <block wx:elif="{{screen === 'layout'}}"><view class="card"><view class="h2">为这篇文章设计专属排版</view><view class="hint">AI 会阅读正文和已有图片说明，自主设计布局与装饰；原文保留，结果另存为新版本。</view><view class="field">设计要求（选填）<textarea value="{{layoutFocus}}" maxlength="500" placeholder="可填写偏好，或留空交给 AI 自主设计" data-field="layoutFocus" bindinput="input" placeholder-class="input-placeholder"/></view><view class="hint">图片未识别时仅参考已有说明；不会额外调用识图。每次重新设计会单独报价。</view><button class="primary" bindtap="quoteLayout" disabled="{{busy}}">预估费用并继续</button></view></block>
 <block wx:elif="{{screen === 'quote'}}"><view class="card"><view class="h2">{{quote.kind === 'layout' ? '确认 AI 排版' : '确认生成草稿'}}</view><view class="quote-summary">{{quoteSummary}}</view><view wx:if="{{quoteFocus}}" class="hint">补充要求：{{quoteFocus}}</view><view class="setting-row"><text>支付账户</text><text>活动发起人</text></view><view class="setting-row">文字 {{quote.texts}} 份 · 图片 {{quote.images}} 张</view><view wx:if="{{quote.visionEnabled}}" class="setting-row">待识图 {{quote.pendingImages}} 张</view><block wx:if="{{quote.billingMode === 'usage'}}"><view class="setting-row">预计消耗约 {{quote.estimatedPoints}} 点</view><view class="quote-limit">本次最多扣 {{quote.price}} 点</view><view class="hint">确认后暂时冻结 {{quote.price}} 点，完成后按实际用量结算，剩余点数退回。</view><view class="hint">按本次确认的计价规则和实际用量结算，本次点数向上取整。</view></block><view wx:else class="quote-limit">本次冻结 {{quote.price}} 点</view><view class="setting-row">发起人可用点数 {{quote.balance}} 点</view></view><view class="hint">由发起人账户支付。确认后冻结点数，未交付完整草稿全额退还。</view><view wx:if="{{quote.balance < quote.price}}" class="notice">点数不足，请发起人联系运营者补充。资料收集和手工编辑不受影响。</view><button wx:else class="primary" bindtap="startTask" loading="{{busy}}" disabled="{{busy}}">{{quote.kind === 'layout' ? '确认费用并开始排版' : '确认费用并生成草稿'}}</button></block>
 <block wx:elif="{{screen === 'task'}}"><view wx:if="{{task}}" class="card center"><view class="h1">{{task.stageText}}</view><block wx:if="{{task.billingMode === 'usage'}}"><view wx:if="{{task.stage === 'succeeded'}}" class="hint">实际扣除 {{task.chargedPoints}} 点 · 退回 {{task.returnedPoints}} 点</view><view wx:else class="hint">本次最多扣 {{task.price}} 点</view><view wx:if="{{task.stage === 'succeeded' && task.billingVerified === false}}" class="notice">本次用量未能核实，已退回全部冻结点数。</view></block><view wx:else class="hint">本次任务 {{task.price}} 点</view><view class="description">{{task.error}}</view><view wx:if="{{task.stage === 'queued' || task.stage === 'vision' || task.stage === 'writing'}}" class="notice">可以离开页面，稍后查看原任务进度。</view><view wx:if="{{task.stage === 'review'}}" class="notice">正在核实原任务，不会重复调用或自动退款。</view><view wx:if="{{task.stage === 'failed'}}" class="notice">冻结点数已退还。</view><button wx:if="{{task.stage === 'succeeded'}}" class="primary" data-screen="article" bindtap="navigate">{{task.kind === 'layout' ? '查看排版结果' : '查看草稿'}}</button><button bindtap="retry">刷新任务状态</button><button data-screen="stream" bindtap="navigate">返回活动</button></view></block>
 <block wx:elif="{{screen === 'edit'}}"><view class="editor-toolbar"><view class="hint" aria-live="polite">{{dirty ? (draftStatus || '有未保存修改') : '已保存为活动文章'}}</view><view class="editor-actions"><button bindtap="toggleEditPreview">{{editPreview ? '继续编辑' : '预览'}}</button><button class="primary" bindtap="saveArticle" loading="{{busy}}" disabled="{{busy}}">保存文章</button></view></view><view wx:if="{{editPreview}}" class="article-paper"><view class="h1">{{editTitle}}</view><rich-text nodes="{{editPreviewHtml}}" selectable/></view><block wx:else><view class="field">标题<input value="{{editTitle}}" maxlength="160" data-field="editTitle" bindinput="editInput"/></view><view class="field">正文 <text class="hint">{{editBody.length}} / 15000 字</text><textarea class="body-editor" value="{{editBody}}" maxlength="15000" data-field="editBody" bindinput="editInput"/></view><view class="h2">配图</view><view wx:for="{{editImages}}" wx:key="path" class="card"><image class="article-image" src="{{item.url}}" mode="widthFix"/><input value="{{item.caption}}" maxlength="300" placeholder="图片说明（选填）" data-index="{{index}}" bindinput="caption" placeholder-class="input-placeholder" placeholder-style="font-size:15px;font-weight:400;color:#65736B"/><view class="row"><button class="link" data-index="{{index}}" data-step="-1" bindtap="moveImage" disabled="{{index === 0}}">上移</button><button class="link" data-index="{{index}}" data-step="1" bindtap="moveImage" disabled="{{index === editImages.length - 1}}">下移</button><button class="link" data-index="{{index}}" bindtap="removeImage">移除</button></view></view></block><button class="primary" bindtap="saveArticle" loading="{{busy}}" disabled="{{busy}}">保存文章</button></block>
 <block wx:elif="{{screen === 'versions'}}"><view wx:for="{{versions}}" wx:key="id" class="card" data-id="{{item.id}}" bindtap="openVersion"><view class="heading"><text>版本 {{item.revision}} · {{item.statusText}}</text><ui-icon name="chevron-right" size="18px"/></view><view class="description">{{item.title}}</view><view class="hint">{{item.revision === article.revision ? '当前版本' : '历史版本 · 点击预览'}}</view><view class="hint">{{item.time}}</view></view></block>
 <block wx:elif="{{screen === 'version'}}"><view class="notice">版本 {{version.revision}} · {{version.body.length}} 字 · {{version.images.length}} 张配图{{version.layout ? ' · 含 AI 排版' : ''}}。恢复后另存为草稿。</view><view class="article-paper"><view class="h1">{{version.title}}</view><rich-text nodes="{{version.displayHtml}}" selectable /></view><button class="primary" bindtap="restoreVersion" disabled="{{!activity.writable || busy}}">恢复此版本</button></block>
 <block wx:elif="{{screen === 'used'}}"><view class="card"><view class="h2">采用资料</view><view wx:for="{{article.usedDetails}}" wx:key="id" class="material-text"><text>{{item.name}}</text><view class="hint">{{item.withdrawn ? '该资料已撤回，请核对文章' : item.text}}</view></view></view><view class="card"><view class="h2">未采用摘要</view><view wx:for="{{omitted}}" wx:key="id">{{item.reason}}</view><view class="hint">指定排除资料未传入本次任务。</view></view></block>
 <block wx:elif="{{screen === 'share'}}"><view class="card"><view class="h2">文章链接</view><view class="hint">电脑打开链接后可复制到公众号后台；也可直接分享给他人阅读。</view><button wx:if="{{!article.shareEnabled}}" class="primary" bindtap="enableShare" loading="{{busy}}" disabled="{{busy}}">开启分享并生成链接</button><block wx:else><button wx:if="{{shareUrl}}" class="primary" bindtap="copyArticleLink" disabled="{{busy}}">复制分享链接</button><view wx:else class="notice">公开分享已开启。本机没有保存原链接，可继续使用此前发出的链接；如需重置，请重新发送给读者。</view><button class="link" bindtap="enableShare" disabled="{{busy}}">重置分享链接</button></block><button wx:if="{{article.shareEnabled}}" class="link" bindtap="closeShare">关闭公开分享</button><view wx:if="{{article.shareEnabled}}" class="hint">重新生成分享链接会使旧链接失效。</view></view><button class="disclosure-row" data-section="publication" bindtap="toggleSection"><text>发布记录</text><ui-icon name="{{expanded.publication ? 'chevron-up' : 'chevron-down'}}" size="20px"/></button><view wx:if="{{expanded.publication}}" class="card"><input value="{{publishUrl}}" placeholder="公众号文章链接（选填）" data-field="publishUrl" bindinput="input" placeholder-class="input-placeholder" placeholder-style="font-size:15px;font-weight:400;color:#65736B"/><button bindtap="markPublished" disabled="{{busy || !activity.writable}}">手动标记已发布</button><view class="hint">仅作记录，系统不会自动发布公众号。</view></view></block>
 <block wx:elif="{{screen === 'profile'}}"><view class="card profile-card"><view class="heading"><text class="h1">{{user.name}}</text><button class="link" bindtap="rename">编辑个人资料</button></view></view><view class="card"><view class="hint">可用点数</view><view class="balance-summary"><text class="balance-number">{{user.balance}}</text><text class="hint">点</text></view><view class="setting-row" data-screen="points" bindtap="navigate"><text>点数明细</text><view class="setting-value"><text></text><ui-icon name="chevron-right" size="18px"/></view></view><view class="setting-row"><text>冻结点数</text><text class="setting-value">{{user.frozen}} 点</text></view><view class="setting-row" data-screen="help" bindtap="navigate"><text>使用说明</text><view class="setting-value"><text></text><ui-icon name="chevron-right" size="18px"/></view></view></view><view class="hint">点数不足请联系运营者申请补充。</view><button class="quiet-button" bindtap="accountSettings" disabled="{{busy}}">账号与个人资料</button></block>
 <block wx:elif="{{screen === 'points'}}"><view class="card heading"><text>可用 {{user.balance}} 点</text><text>冻结 {{user.frozen}} 点</text></view><view class="hint">点数不足请联系运营者申请补充。</view><view wx:if="{{!ledger.length && !error}}" class="empty">暂无点数记录</view><view wx:for="{{ledger}}" wx:key="id" class="card heading" data-index="{{index}}" bindtap="pointDetail"><view><view>{{item.label}}</view><view class="hint">{{item.time}}</view></view><text>{{item.amount > 0 ? '+' : ''}}{{item.amount}}</text></view><button wx:if="{{hasMorePoints}}" bindtap="morePoints" disabled="{{busy}}">加载更多</button></block>
 <view wx:elif="{{screen === 'help'}}" class="card prose"><view class="h2">使用说明</view><text>创建活动后分享邀请，参与者可以提交文字与照片。\n\n发起人和协作者可整理素材、生成和编辑文章。协作者使用 AI 需单独获得授权，消耗发起人的点数。\n\n创建、收集、手工编辑、定稿和导出免费。AI 任务确认费用后才启动。\n\n文章定稿后可以分享链接，或在电脑打开链接，将正文复制到公众号后台手动发布。</text></view>
 <view wx:elif="{{screen === 'access'}}" class="empty">没有活动访问权限，可能已被移出。<button bindtap="goHome">返回共创活动</button></view>

</view>
