<app-nav title="{{screen === 'home' ? '活动文章共创' : ((screen === 'stream' || screen === 'article') ? '共创活动' : title)}}" show-back="{{true}}" custom-back="{{true}}" bindback="back" bindhome="hub"></app-nav>
<view class="page {{screen === 'share' ? 'with-share-dock' : ''}} {{screen === 'materials' ? 'with-selection-dock' : ''}} {{screen === 'article' && article && activity.manager ? 'with-article-dock' : ''}} {{screen === 'stream' && activity.status === 'collecting' ? 'with-composer' : ''}}">

 <view wx:if="{{error}}" class="error"><text>{{error}}</text><button class="link" bindtap="retry">重试</button></view>
 <view wx:if="{{loading}}" class="loading" aria-live="polite">正在加载…</view><view wx:elif="{{refreshing}}" class="refresh-status" aria-live="polite">正在更新，现有内容可继续查看</view>
 <view wx:if="{{screen === 'privacy'}}" class="card prose"><view class="h2">隐私说明</view><text>微信身份标识用于关联账号，显示姓名仅用于展示。同名用户不会共享账号。\n\n活动文字和图片仅向有权限的成员展示；确认 AI 任务后，必要资料会发送给模型服务处理。\n\n公开文章通过主动分享的链接访问，管理者可关闭分享。撤回资料不会自动撤回已复制或发布到外部的内容。</text></view>
 <block wx:elif="{{screen === 'name'}}"><view class="h1">怎么称呼你？</view><view class="field">显示姓名<input value="{{name}}" maxlength="30" placeholder="真实姓名或常用称呼" data-field="name" bindinput="input" placeholder-class="input-placeholder" placeholder-style="font-size:15px;font-weight:400;color:#65736B"/></view><button class="primary" loading="{{busy}}" disabled="{{busy}}" bindtap="saveName">保存</button></block>
 <block wx:elif="{{screen === 'home'}}">
  <view class="heading home-heading"><text class="h1">共创活动</text><view class="row"><button data-screen="join" bindtap="navigate">加入</button><button class="primary" data-screen="create" bindtap="navigate"><ui-icon name="add" size="18px" tone="on-accent"/><text>创建</text></button></view></view>

  <scroll-view scroll-x class="filters"><button wx:for="{{filters}}" wx:key="*this" class="{{filter === item ? 'selected' : ''}}" data-value="{{item}}" bindtap="setFilter">{{item}}</button></scroll-view>
  <view wx:if="{{!loading && !activities.length && !error}}" class="collab-empty"><image class="collab-empty-art" src="/assets/redesign/collab-empty.png" mode="aspectFit" aria-hidden="true"/><view wx:if="{{filter !== '全部'}}" class="hint">暂无{{filter}}活动</view><button class="primary empty-create" data-screen="create" bindtap="navigate"><ui-icon name="add" size="18px" tone="on-accent"/><text>创建新活动</text></button><button class="empty-join" data-screen="join" bindtap="navigate">输入邀请码加入已有活动</button></view>
  <view wx:for="{{activities}}" wx:key="id" class="card activity" data-id="{{item.id}}" bindtap="openActivity" role="button" aria-label="{{item.name}}，{{item.displayStatus}}"><view class="activity-title-row"><view class="h2">{{item.name}}</view><text class="badge {{item.formed ? 'formed' : ''}}">{{item.displayStatus}}</text></view><view class="card-footer"><view wx:if="{{item.role === 'owner' || item.role === 'collaborator'}}" class="activity-role">{{item.role === 'owner' ? '由我发起' : '参与协作'}}</view><text>{{item.memberCount}} 人</text><text>·</text><text>{{item.materialCount}} 份资料</text></view><view wx:if="{{item.articleStatus === 'draft' || (item.taskText && item.latestTask.stage !== 'succeeded')}}" class="article-state"><text wx:if="{{item.articleStatus === 'draft'}}">草稿待核对</text><text wx:if="{{item.taskText && item.latestTask.stage !== 'succeeded'}}">{{item.articleStatus === 'draft' ? ' · ' : ''}}AI {{item.taskText}}</text></view></view>
 </block>
 <block wx:elif="{{screen === 'demo'}}"><view class="card prose"><view class="hint">演示内容 · 以下人物与活动均为虚构</view><view class="h1">一起寻找校园里的秋天</view><view>周五下午，同学们带着观察卡走进校园。有人记录树叶的颜色，有人画下花坛的轮廓，还有人把发现写成一段小诗。</view><view>分享时，大家把各自的观察贴在同一张海报上。原来，每个人眼中的秋天都不一样，汇在一起就成了一段完整的班级记忆。</view><view class="h2">这篇文章怎样共创？</view><view>发起人提出活动主题，成员分别提交观察文字和照片；整理者挑选素材，生成草稿后核对事实，再决定是否分享。</view><button class="primary" data-screen="create" bindtap="navigate">创建我的共创活动</button></view></block>
 <block wx:elif="{{screen === 'create' || screen === 'info'}}"><view class="field">活动名称 *<input value="{{name}}" maxlength="80" data-field="name" bindinput="input" placeholder="填写活动名称" placeholder-class="input-placeholder" placeholder-style="font-size:15px;font-weight:400;color:#65736B"/></view><view class="field">活动说明（非必填）<textarea value="{{description}}" maxlength="2000" data-field="description" bindinput="input" placeholder="输入活动的简单介绍" placeholder-class="input-placeholder" placeholder-style="font-size:15px;font-weight:400;color:#65736B"/></view><button wx:if="{{screen === 'create'}}" class="primary" bindtap="create" loading="{{busy}}" disabled="{{busy}}">创建活动</button><button wx:else class="primary" bindtap="saveInfo" loading="{{busy}}" disabled="{{busy}}">保存</button></block>
 <block wx:elif="{{screen === 'created'}}"><view class="created-summary"><view class="hint">活动已创建</view><view class="h1">{{activity.name}}</view><view wx:if="{{activity.description}}" class="description">{{activity.description}}</view><view wx:if="{{activity.imageLimit}}" class="created-limit">注意：每个活动的图片合计上限为{{activity.imageLimit}}张</view><view class="created-actions"><button class="primary" data-screen="invite" bindtap="navigate">邀请参与者</button><button data-screen="stream" bindtap="navigate">进入活动</button></view></view></block>
 <block wx:elif="{{screen === 'join'}}"><view class="join-code-panel"><view class="field">输入邀请码<input class="join-code-input" value="{{inviteCode}}" data-field="inviteCode" bindinput="input" bindconfirm="checkInvite" confirm-type="go" maxlength="6" type="number" placeholder="输入6位邀请码" aria-label="六位数字邀请码"/></view><button class="primary join-submit" bindtap="checkInvite" loading="{{busy}}" disabled="{{busy}}">进入活动</button></view></block>
 <block wx:elif="{{screen === 'invitation'}}"><view wx:if="{{invite}}" class="invitation-summary"><view class="h1">{{invite.name}}</view><view class="invitation-meta"><view class="invitation-owner"><text>发起人：</text><text class="owner-name">{{invite.ownerName || '微信用户'}}</text></view><text class="badge">{{invite.statusText}}</text></view><view wx:if="{{invite.description}}" class="description">{{invite.description}}</view><view wx:if="{{invite.status === 'paused'}}" class="hint">活动已暂停收集，加入后可查看资料。</view><view wx:if="{{invite.status === 'archived' && !invite.joined}}" class="hint">活动已归档，暂不接受新成员。</view><button wx:else class="primary join-submit" bindtap="join" loading="{{busy}}" disabled="{{busy}}">{{invite.joined ? '进入活动' : '确认加入'}}</button></view></block>
 <block wx:elif="{{screen === 'invite'}}"><view class="card center"><view class="h2">{{activity.name}}</view><view class="hint">邀请码</view><view class="invite-code">{{activity.inviteCode}}</view><button class="primary" bindtap="copyInvite">复制邀请码</button><button open-type="share">分享活动给微信好友</button><button bindtap="showQr" loading="{{busy}}">活动二维码</button><image wx:if="{{qrImage}}" class="qr-image" src="{{qrImage}}" show-menu-by-longpress mode="widthFix"/></view></block>
 <block wx:elif="{{screen === 'stream' || screen === 'materials' || screen === 'article' || screen === 'settings'}}">
  <view class="activity-header"><view class="h1">{{activity.name}}</view><view class="activity-meta"><text class="badge">{{activity.displayStatus}}</text><button class="link" data-screen="members" bindtap="navigate"><text>{{activity.memberCount}} 位成员</text><ui-icon name="chevron-right" size="18px"/></button></view></view>
  <view class="activity-tabs"><button class="{{screen === 'stream' ? 'selected' : ''}}" data-screen="stream" bindtap="navigate">资料</button><button wx:if="{{activity.manager}}" class="{{screen === 'materials' ? 'selected' : ''}}" data-screen="materials" bindtap="navigate">选材</button><button class="{{screen === 'article' ? 'selected' : ''}}" data-screen="article" bindtap="navigate">文章</button><button wx:if="{{activity.manager}}" class="{{screen === 'settings' ? 'selected' : ''}}" data-screen="settings" bindtap="navigate">管理</button></view>
  <block wx:if="{{screen === 'stream'}}">
   <button wx:if="{{activity.manager && activity.articleStatus === 'draft' && !loading && !error}}" class="link stream-draft-link" data-screen="article" bindtap="navigate"><text>草稿已就绪，前往核对</text><ui-icon name="chevron-right" size="18px"/></button>
   <button wx:if="{{newCount}}" class="link" bindtap="latest">有新资料，点击查看</button><view wx:if="{{activity.announcement}}" class="notice">{{activity.announcement}}</view><button wx:if="{{activity.manager && (activity.latestTask || task.activityId === activity.id)}}" class="link task-link" bindtap="taskPage"><text>{{activity.latestTask.stage === 'succeeded' ? '查看生成结果' : activity.latestTask.stage === 'failed' ? '查看失败原因' : '查看生成进度'}}</text><ui-icon name="chevron-right" size="18px"/></button>
   <button wx:if="{{hasMore}}" class="link" bindtap="history" disabled="{{busy}}">加载历史资料</button>
   <view wx:if="{{!materials.length && !loading && !error}}" class="empty">还没有资料，发送文字或照片开始记录。</view>
   <view wx:for="{{materials}}" wx:key="id" class="message"><view class="avatar"><image wx:if="{{item.avatarUrl}}" src="{{item.avatarUrl}}" mode="aspectFill" data-id="{{item.id}}" binderror="materialAvatarError"/><ui-icon wx:else name="person" size="24px" tone="accent"/></view><view class="message-body"><view class="message-meta"><text>{{item.name}}</text><text>{{item.time}}</text></view><view wx:if="{{item.withdrawn}}" class="withdrawn">该资料已撤回</view><block wx:else><view class="bubble"><text wx:if="{{item.text}}" class="message-text" user-select>{{item.text}}</text><view wx:if="{{item.images.length}}" class="photos"><image wx:for="{{item.images}}" wx:for-item="photo" wx:key="path" src="{{photo.url}}" mode="aspectFill" lazy-load data-url="{{photo.url}}" data-urls="{{item.imageUrls}}" bindtap="previewPhoto"/></view></view><button wx:if="{{item.own && activity.writable}}" class="link" data-id="{{item.id}}" bindtap="withdraw">撤回</button></block></view></view><view id="latest-message"/>
   <view wx:if="{{activity.status === 'collecting'}}" class="composer {{keyboardHeight ? 'keyboard-open' : ''}}" style="bottom:{{keyboardHeight}}px"><textarea adjust-position="{{false}}" bindkeyboardheightchange="keyboardChange" value="{{message}}" maxlength="5000" data-field="message" bindinput="input" disabled="{{busy || sendError}}" placeholder="填写文字或图片说明" placeholder-class="input-placeholder" placeholder-style="font-size:15px;font-weight:400;color:#65736B"/><view wx:if="{{photos.length}}" class="pending"><view wx:for="{{photos}}" wx:key="path"><image src="{{item.path}}" mode="aspectFill" data-url="{{item.path}}" bindtap="previewPhoto"/><button wx:if="{{!busy && !sendError}}" class="link" data-index="{{index}}" bindtap="removePhoto">移除</button></view></view><view wx:if="{{sendError}}" class="error">{{sendError}}，输入与照片已保留。</view><view wx:if="{{progress}}" class="hint">{{progress}}</view><view class="heading"><button class="link icon-label" bindtap="choosePhotos" disabled="{{busy || sendError}}"><ui-icon name="photo" size="20px"/><text>添加图片{{activity.imageLimit ? '（' + (activity.imageCount || 0) + '/' + activity.imageLimit + '）' : ''}}</text></button><button class="primary" bindtap="send" loading="{{busy}}" disabled="{{busy}}">{{sendError ? '重试发送' : '发送'}}</button></view></view><view wx:else class="notice">{{activity.status === 'archived' ? '活动已归档，资料只读。' : '已暂停收集，暂时不能提交资料。'}}</view>
  </block>
  <block wx:if="{{screen === 'materials'}}">
   <view wx:if="{{!activity.writable}}" class="notice">活动已归档，素材只读。</view>
   <view class="heading material-toolbar"><text class="hint">共收集 {{displayMaterials.length}} 份资料</text><button bindtap="selectAllMaterials" disabled="{{!activity.writable || busy || loading}}">{{allMaterialsSelected ? '取消全选' : '全选所有资料'}}</button></view>
   <view wx:for="{{materialGroups}}" wx:for-item="group" wx:key="userId" class="card material-group"><view class="material-group-header"><view class="material-author"><image wx:if="{{group.avatarUrl}}" class="material-avatar" src="{{group.avatarUrl}}" mode="aspectFill"/><view wx:else class="material-avatar"><ui-icon name="person" size="24px" tone="accent"/></view><text>{{group.name}}</text></view><text class="hint">贡献：{{group.items.length}}份</text></view><view wx:for="{{group.items}}" wx:key="id" class="material-choice"><view class="material-choice-heading"><text wx:if="{{item.text}}" class="material-choice-text">{{item.text}}</text><checkbox-group data-id="{{item.id}}" bindchange="checkMaterial"><label class="material-use"><checkbox checked="{{item.checked}}" disabled="{{!activity.writable || busy}}" color="#285b4b"/><text>选用</text></label></checkbox-group></view><view wx:if="{{item.images.length}}" class="photos"><image wx:for="{{item.images}}" wx:for-item="photo" wx:key="path" src="{{photo.url}}" mode="aspectFill" lazy-load data-url="{{photo.url}}" data-urls="{{item.imageUrls}}" bindtap="previewPhoto"/></view></view></view>
   <view wx:if="{{!displayMaterials.length && !loading}}" class="empty">暂无可选资料</view><view wx:if="{{!activity.writable || !activity.aiAuthorized}}" class="hint">{{!activity.writable ? '活动已归档，恢复后可继续生成。' : '使用 AI 需发起人授权，仍可选择资料。'}}</view><view class="selection-dock"><text>已选 {{checked.length}} 份资料</text><button class="primary" bindtap="generate" disabled="{{!checked.length || !activity.writable || loading || busy || !activity.aiAuthorized}}">生成文章草稿</button></view>
  </block>
  <block wx:if="{{screen === 'settings'}}">
   <view class="card"><button class="setting-row" bindtap="editInfo" disabled="{{!activity.writable}}"><text>活动信息</text><view class="setting-value"><text></text><ui-icon name="chevron-right" size="18px"/></view></button><button class="setting-row" bindtap="editAnnouncement" disabled="{{!activity.writable}}"><text>活动公告</text><view class="setting-value"><text></text><ui-icon name="chevron-right" size="18px"/></view></button><button class="setting-row" data-screen="members" bindtap="navigate"><text>成员与协作者</text><view class="setting-value"><text></text><ui-icon name="chevron-right" size="18px"/></view></button><button wx:if="{{activity.owner}}" class="setting-row" bindtap="collection"><text>收集状态</text><view class="setting-value"><text>{{activity.statusText}}</text><ui-icon name="chevron-right" size="18px"/></view></button><button class="setting-row" data-screen="invite" bindtap="navigate" disabled="{{!activity.writable}}"><text>邀请参与者</text><view class="setting-value"><text></text><ui-icon name="chevron-right" size="18px"/></view></button><button wx:if="{{activity.owner}}" class="setting-row" bindtap="resetInvite" disabled="{{!activity.writable}}"><text>重置邀请</text><view class="setting-value"><text></text><ui-icon name="chevron-right" size="18px"/></view></button></view>
  </block>
  <block wx:if="{{screen === 'article'}}">
   <view wx:if="{{!article && !loading && !error}}" class="article-empty"><view class="h2">{{activity.manager ? (checked.length ? '已选好资料，可以生成文章草稿' : '先选材，再生成文章草稿') : '等待管理者生成文章'}}</view><image class="article-empty-art" src="/assets/redesign/collab-empty.png" mode="aspectFit" aria-hidden="true"/><button wx:if="{{activity.manager && checked.length}}" class="link" bindtap="generate" disabled="{{!activity.writable || busy}}">生成文章草稿</button><button wx:elif="{{activity.manager}}" class="link" data-screen="materials" bindtap="navigate">前往选材<ui-icon name="chevron-right" size="18px"/></button></view>
   <block wx:if="{{article}}"><view class="article-paper"><view class="article-title-line"><text class="h1">{{article.title}}</text><text class="article-version">{{article.statusText}} 版本{{article.revision}}</text></view><rich-text nodes="{{article.displayHtml}}" selectable /></view>
   <block wx:if="{{activity.manager}}">
    <view class="article-tools article-dock">
     <button class="link article-more" bindtap="articleMore" aria-label="更多文章操作"><ui-icon name="ellipsis" size="20px"/><text>更多</text></button>
     <button class="edit-action" bindtap="editArticle" disabled="{{!activity.writable || busy}}">编辑文章</button>
     <button wx:if="{{article.status === 'draft' && activity.writable}}" class="primary finalize-action" bindtap="finalize" disabled="{{busy}}">定稿并发布</button>
     <button wx:if="{{article.status === 'final'}}" class="primary finalize-action" bindtap="sharePage">查看分享链接</button>
    </view>
   </block></block>
  </block>
 </block>
 <block wx:elif="{{screen === 'members'}}"><view class="card"><view wx:for="{{members}}" wx:key="userId" class="member"><view><text>{{item.name}}</text><view class="hint">{{item.roleText}}{{item.ai && item.role === 'collaborator' ? ' · 已获 AI 授权' : ''}}</view></view><button wx:if="{{activity.owner && activity.writable && item.role !== 'owner'}}" class="link" data-index="{{index}}" bindtap="memberAction">管理</button></view></view><button wx:if="{{activity.manager && activity.writable}}" class="primary" data-screen="invite" bindtap="navigate">邀请参与者</button><view wx:if="{{activity.owner}}" class="hint">协作者默认没有消费点数权限，需单独授权。</view></block>
 <block wx:elif="{{screen === 'announcement'}}"><view class="field">活动公告<textarea value="{{announcement}}" maxlength="1000" data-field="announcement" bindinput="input"/></view><button class="primary" bindtap="saveAnnouncement" loading="{{busy}}" disabled="{{busy}}">保存</button></block>
 <block wx:elif="{{screen === 'generate'}}"><view class="h1">{{activity.name}}</view><button class="link selected-materials-link" bindtap="reviewSelected"><text>已选择 {{checked.length}} 份资料</text><image class="selected-materials-arrow" src="/assets/ui/icons/chevron-right-default.svg" mode="aspectFit" aria-hidden="true"/></button><button class="disclosure-row" data-section="generation" bindtap="toggleSection"><text>生成设置</text><ui-icon name="{{expanded.generation ? 'chevron-up' : 'chevron-down'}}" size="20px"/></button><view wx:if="{{expanded.generation}}"><view class="field">篇幅<picker disabled="{{busy}}" range="{{lengths}}" value="{{lengthIndex}}" data-field="lengthIndex" bindchange="picker"><view class="select-row"><text>{{lengths[lengthIndex]}}</text><ui-icon name="chevron-down" size="18px"/></view></picker></view><view class="field">语气<picker disabled="{{busy}}" range="{{tones}}" value="{{toneIndex}}" data-field="toneIndex" bindchange="picker"><view class="select-row"><text>{{tones[toneIndex]}}</text><ui-icon name="chevron-down" size="18px"/></view></picker></view><view class="field">其他要求（选填）<textarea disabled="{{busy}}" value="{{focus}}" maxlength="500" data-field="focus" bindinput="input"/></view></view><checkbox-group class="generation-layout-option" bindchange="toggleGenerationLayout"><label class="generation-layout-label"><checkbox disabled="{{busy}}" value="layout" checked="{{withLayout}}" color="#245D50"/><text>AI 美化排版</text></label></checkbox-group><view class="hint generation-layout-hint">根据文章内容优化正文排版，{{layoutExtraPoints !== null ? '预计额外消耗 ' + layoutExtraPoints + ' 点。' : '会额外消耗点数，以实际用量结算。'}}</view><view class="generation-estimate" aria-live="polite"><text wx:if="{{estimateLoading}}" class="hint">正在预估点数…</text><view wx:elif="{{generationEstimate !== null}}" class="generation-estimate-row"><text>预计消耗 {{generationEstimate}} 点</text><button wx:if="{{generationQuote}}" class="generation-fee-info" bindtap="showGenerationFeeInfo" aria-label="查看费用说明"><image src="/assets/ui/icons/info-circle-default.svg" mode="aspectFit" aria-hidden="true"/></button></view><text wx:else class="hint">{{estimateError || '确认费用后查看本次报价'}}</text></view><view wx:if="{{generationQuote && generationQuote.balance < generationQuote.price}}" class="notice">点数不足，请活动发起人补充点数。</view><button class="primary" bindtap="confirmGeneration" loading="{{busy}}" disabled="{{busy || estimateLoading || generationEstimate === null || !generationQuote || generationQuote.balance < generationQuote.price}}">确认费用并生成草稿</button></block>
 <block wx:elif="{{screen === 'layout'}}"><view class="card"><view class="h2">为这篇文章设计专属排版</view><view class="hint">AI 会阅读正文和已有图片说明，自主设计布局与装饰；原文保留，结果另存为新版本。</view><view class="field">设计要求（选填）<textarea value="{{layoutFocus}}" maxlength="500" placeholder="可填写偏好，或留空交给 AI 自主设计" data-field="layoutFocus" bindinput="input" placeholder-class="input-placeholder"/></view><view class="hint">图片未识别时仅参考已有说明；不会额外调用识图。每次重新设计会单独报价。</view><button class="primary" bindtap="quoteLayout" disabled="{{busy}}">预估费用并继续</button></view></block>
 <block wx:elif="{{screen === 'quote'}}"><view class="card"><view class="h2">{{quote.kind === 'layout' ? '确认 AI 排版' : '确认生成草稿'}}</view><view class="quote-summary">{{quoteSummary}}</view><view wx:if="{{quoteFocus}}" class="hint">补充要求：{{quoteFocus}}</view><view class="setting-row"><text>支付账户</text><text>活动发起人</text></view><view class="setting-row">文字 {{quote.texts}} 份 · 图片 {{quote.images}} 张</view><view wx:if="{{quote.visionEnabled}}" class="setting-row">待识图 {{quote.pendingImages}} 张</view><block wx:if="{{quote.billingMode === 'usage'}}"><view class="setting-row">预计消耗约 {{quote.estimatedPoints}} 点</view><view class="quote-limit">本次最多扣 {{quote.price}} 点</view><view class="hint">确认后暂时冻结 {{quote.price}} 点，完成后按实际用量结算，剩余点数退回。</view><view class="hint">按本次确认的计价规则和实际用量结算，本次点数向上取整。</view></block><view wx:else class="quote-limit">本次冻结 {{quote.price}} 点</view><view class="setting-row">发起人可用点数 {{quote.balance}} 点</view></view><view class="hint">由发起人账户支付。确认后冻结点数，未交付完整草稿全额退还。</view><view wx:if="{{quote.balance < quote.price}}" class="notice">点数不足，请发起人联系运营者补充。资料收集和手工编辑不受影响。</view><button wx:else class="primary" bindtap="startTask" loading="{{busy}}" disabled="{{busy}}">{{quote.kind === 'layout' ? '确认费用并开始排版' : '确认费用并生成草稿'}}</button></block>
 <block wx:elif="{{screen === 'task'}}"><view wx:if="{{task}}" class="card center"><view class="h1">{{task.stageText}}</view><block wx:if="{{task.billingMode === 'usage'}}"><view wx:if="{{task.stage === 'succeeded'}}" class="hint">实际扣除 {{task.chargedPoints}} 点 · 退回 {{task.returnedPoints}} 点</view><view wx:else class="hint">本次最多扣 {{task.price}} 点</view><view wx:if="{{task.stage === 'succeeded' && task.billingVerified === false}}" class="notice">本次用量未能核实，已退回全部冻结点数。</view></block><view wx:else class="hint">本次任务 {{task.price}} 点</view><view class="description">{{task.error}}</view><view wx:if="{{task.stage === 'queued' || task.stage === 'vision' || task.stage === 'writing'}}" class="notice">可以离开页面，稍后查看原任务进度。</view><view wx:if="{{task.stage === 'review'}}" class="notice">正在核实原任务，不会重复调用或自动退款。</view><view wx:if="{{task.stage === 'failed'}}" class="notice">冻结点数已退还。</view><button wx:if="{{task.stage === 'succeeded'}}" class="primary" data-screen="article" bindtap="navigate">{{task.kind === 'layout' ? '查看排版结果' : '查看草稿'}}</button><button bindtap="retry">刷新任务状态</button><button data-screen="stream" bindtap="navigate">返回活动</button></view></block>
 <block wx:elif="{{screen === 'edit'}}"><view class="editor-toolbar"><view class="hint" aria-live="polite">{{dirty ? (draftStatus || '有未保存修改') : '已保存为活动文章'}}</view><view class="editor-actions"><button bindtap="toggleEditPreview">{{editPreview ? '继续编辑' : '预览'}}</button><button class="primary" bindtap="saveArticle" loading="{{busy}}" disabled="{{busy}}">保存文章</button></view></view><view wx:if="{{editPreview}}" class="article-paper"><view class="h1">{{editTitle}}</view><rich-text nodes="{{editPreviewHtml}}" selectable/></view><block wx:else><view class="field">标题<input value="{{editTitle}}" maxlength="160" data-field="editTitle" bindinput="editInput"/></view><view class="field">正文 <text class="hint">{{editBody.length}} / 15000 字</text><textarea class="body-editor" value="{{editBody}}" maxlength="15000" data-field="editBody" bindinput="editInput"/></view><view class="h2">配图</view><view wx:for="{{editImages}}" wx:key="path" class="card"><image class="article-image" src="{{item.url}}" mode="widthFix"/><input value="{{item.caption}}" maxlength="300" placeholder="图片说明（选填）" data-index="{{index}}" bindinput="caption" placeholder-class="input-placeholder" placeholder-style="font-size:15px;font-weight:400;color:#65736B"/><view class="row"><button class="link" data-index="{{index}}" data-step="-1" bindtap="moveImage" disabled="{{index === 0}}">上移</button><button class="link" data-index="{{index}}" data-step="1" bindtap="moveImage" disabled="{{index === editImages.length - 1}}">下移</button><button class="link" data-index="{{index}}" bindtap="removeImage">移除</button></view></view></block><button class="primary" bindtap="saveArticle" loading="{{busy}}" disabled="{{busy}}">保存文章</button></block>
 <block wx:elif="{{screen === 'versions'}}"><view wx:for="{{versions}}" wx:key="id" class="card" data-id="{{item.id}}" bindtap="openVersion"><view class="heading"><text>版本 {{item.revision}} · {{item.statusText}}</text><ui-icon name="chevron-right" size="18px"/></view><view class="description">{{item.title}}</view><view class="hint">{{item.revision === article.revision ? '当前版本' : '历史版本 · 点击预览'}}</view><view class="hint">{{item.time}}</view></view></block>
 <block wx:elif="{{screen === 'version'}}"><view class="notice">版本 {{version.revision}} · {{version.body.length}} 字 · {{version.images.length}} 张配图{{version.layout ? ' · 含 AI 排版' : ''}}。恢复后另存为草稿。</view><view class="article-paper"><view class="h1">{{version.title}}</view><rich-text nodes="{{version.displayHtml}}" selectable /></view><button class="primary" bindtap="restoreVersion" disabled="{{!activity.writable || busy}}">恢复此版本</button></block>
 <block wx:elif="{{screen === 'used'}}"><view class="card"><view class="h2">采用资料</view><view wx:for="{{article.usedDetails}}" wx:key="id" class="material-text"><text>{{item.name}}</text><view class="hint">{{item.withdrawn ? '该资料已撤回，请核对文章' : item.text}}</view></view></view><view class="card"><view class="h2">未采用摘要</view><view wx:for="{{omitted}}" wx:key="id">{{item.reason}}</view><view class="hint">指定排除资料未传入本次任务。</view></view></block>
 <block wx:elif="{{screen === 'share'}}"><view wx:if="{{shareArticle}}" class="shared-reader-content"><view class="shared-reader-title">{{shareArticle.title}}</view><rich-text nodes="{{shareDisplayHtml}}" selectable/></view><view class="shared-reader-dock"><button bindtap="copyArticleLink" disabled="{{busy || !shareUrl || !shareArticle}}">复制文章链接</button><button class="primary" open-type="share" disabled="{{busy || !shareUrl || !shareArticle}}">分享文章</button></view></block>
 <block wx:elif="{{screen === 'profile'}}"><view class="card profile-card"><view class="heading"><text class="h1">{{user.name}}</text><button class="link" bindtap="rename">编辑个人资料</button></view></view><view class="card"><view class="hint">可用点数</view><view class="balance-summary"><text class="balance-number">{{user.balance}}</text><text class="hint">点</text></view><view class="setting-row" data-screen="points" bindtap="navigate"><text>点数明细</text><view class="setting-value"><text></text><ui-icon name="chevron-right" size="18px"/></view></view><view class="setting-row"><text>冻结点数</text><text class="setting-value">{{user.frozen}} 点</text></view><view class="setting-row" data-screen="help" bindtap="navigate"><text>使用说明</text><view class="setting-value"><text></text><ui-icon name="chevron-right" size="18px"/></view></view></view><view class="hint">点数不足请联系运营者申请补充。</view><button class="quiet-button" bindtap="accountSettings" disabled="{{busy}}">账号与个人资料</button></block>
 <block wx:elif="{{screen === 'points'}}"><view class="card heading"><text>可用 {{user.balance}} 点</text><text>冻结 {{user.frozen}} 点</text></view><view class="hint">点数不足请联系运营者申请补充。</view><view wx:if="{{!ledger.length && !error}}" class="empty">暂无点数记录</view><view wx:for="{{ledger}}" wx:key="id" class="card heading" data-index="{{index}}" bindtap="pointDetail"><view><view>{{item.label}}</view><view class="hint">{{item.time}}</view></view><text>{{item.amount > 0 ? '+' : ''}}{{item.amount}}</text></view><button wx:if="{{hasMorePoints}}" bindtap="morePoints" disabled="{{busy}}">加载更多</button></block>
 <view wx:elif="{{screen === 'help'}}" class="card prose"><view class="h2">使用说明</view><text>创建活动后分享邀请，参与者可以提交文字与照片。\n\n发起人和协作者可整理素材、生成和编辑文章。协作者使用 AI 需单独获得授权，消耗发起人的点数。\n\n创建、收集、手工编辑、定稿和导出免费。AI 任务确认费用后才启动。\n\n文章定稿后可以分享链接，或在电脑打开链接，将正文复制到公众号后台手动发布。</text></view>
 <view wx:elif="{{screen === 'access'}}" class="empty">没有活动访问权限，可能已被移出。<button bindtap="goHome">返回共创活动</button></view>

</view>
