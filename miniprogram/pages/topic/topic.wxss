.topic-summary {
  background: #e9efff;
  border-color: #d2ddf8;
}
.invite-code {
  font-size: 36rpx;
  color: #2457d6;
  font-weight: 700;
  letter-spacing: 4rpx;
}
.article-entry {
  width: 100%;
  margin-bottom: 24rpx;
}
.closed-note {
  padding: 24rpx;
  background: #ddf3e8;
  color: #176341;
  border-radius: 20rpx;
  font-size: 26rpx;
}
.author {
  font-size: 28rpx;
  font-weight: 600;
  word-break: break-all;
}
.material-text {
  margin-top: 24rpx;
  white-space: pre-wrap;
  word-break: break-all;
  font-size: 30rpx;
  line-height: 1.8;
}
.legacy-voice {
  padding: 24rpx;
  background: #f1f4f8;
  margin-top: 24rpx;
  border-radius: 16rpx;
  font-size: 26rpx;
  color: #59677d;
}
.image-frame {
  height: 360rpx;
  width: 100%;
  background: #edf1f6;
  border-radius: 20rpx;
  overflow: hidden;
  margin-top: 24rpx;
}
.material-img {
  width: 100%;
  height: 360rpx;
}
.image-fallback {
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #59677d;
  font-size: 26rpx;
}
.composer {
  position: fixed;
  left: 0;
  right: 0;
  background: #fff;
  border-top: 2rpx solid #d6deea;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  z-index: 5;
}
.composer.keyboard-open {
  padding-bottom: 20rpx;
}
.composer-input {
  width: 100%;
  height: 100rpx;
  background: #f7f9fc;
  border: 2rpx solid #cad3e0;
  border-radius: 20rpx;
  padding: 16rpx 20rpx;
  font-size: 28rpx;
  margin-bottom: 12rpx;
}
.composer-input.expanded {
  height: 240rpx;
}
.composer .row {
  gap: 8rpx;
}
.composer button {
  padding: 16rpx;
  min-height: 88rpx;
}
.composer .expand-btn {
  font-size: 24rpx;
}
.composer-spacer {
  height: calc(260rpx + env(safe-area-inset-bottom));
  box-sizing: content-box;
}
.composer-spacer.expanded {
  height: calc(400rpx + env(safe-area-inset-bottom));
}

.draft-spacer {
  height: 480rpx;
}
.composer {
  max-height: 85vh;
  overflow-y: auto;
}
.composer.keyboard-open {
  max-height: 55vh;
}
.image-drafts {
  padding-bottom: 16rpx;
}
.draft-heading {
  min-height: 72rpx;
}
.draft-scroll {
  height: 300rpx;
}
.draft-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  padding-bottom: 8rpx;
}
.draft-tile {
  width: calc(33.333% - 8rpx);
  padding: 12rpx;
  border: 2rpx solid #d6deea;
  border-radius: 16rpx;
}
.draft-thumb {
  display: block;
  width: 100%;
  height: 112rpx;
  border-radius: 10rpx;
}
.draft-status {
  display: block;
  font-size: 24rpx;
  color: #2457d6;
  margin-top: 8rpx;
}
.draft-status--failed,
.draft-error {
  color: #ac3127;
}
.draft-error {
  display: block;
  font-size: 24rpx;
  word-break: break-all;
}
.composer .remove-image {
  width: 100%;
  min-height: 64rpx;
  padding: 8rpx;
  margin-top: 8rpx;
  font-size: 24rpx;
}
.composer .retry-images {
  min-height: 64rpx;
  font-size: 24rpx;
  padding: 8rpx 12rpx;
}
