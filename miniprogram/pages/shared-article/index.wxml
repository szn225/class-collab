<app-nav title="分享与发布" show-home="{{true}}"/>
<view class="reader-page with-share-dock"><view wx:if="{{loading}}" class="reader-state">正在加载文章…</view><view wx:elif="{{error}}" class="reader-state"><view>{{error}}</view><button wx:if="{{!unavailable}}" bindtap="loadArticle">重新加载</button></view><block wx:elif="{{article}}"><view class="shared-reader-title">{{article.title}}</view><rich-text nodes="{{displayHtml}}" selectable/><view class="shared-reader-dock"><button bindtap="copyArticleLink">复制文章链接</button><button class="primary" open-type="share">分享文章</button></view></block></view>
