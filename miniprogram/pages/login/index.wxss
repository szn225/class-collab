page{background:#f6f7f5;color:#243a31}.login-page{padding:100rpx 48rpx}.login-symbol{width:96rpx;height:96rpx;line-height:96rpx;text-align:center;background:#285b4b;color:#fff;border-radius:28rpx;font-size:48rpx;margin-bottom:48rpx}.login-title{font-size:46rpx;font-weight:600;line-height:1.4}.login-note{font-size:28rpx;line-height:1.8;color:#7b877f;margin:22rpx 0 64rpx}.login-primary{width:100%;height:100rpx;line-height:100rpx;border-radius:24rpx;background:#285b4b;color:#fff;font-size:31rpx}.login-error{color:#aa4c32;font-size:27rpx;line-height:1.6;margin:24rpx 0}checkbox-group{display:flex;justify-content:center;align-items:center;margin-top:24rpx}.consent-row{display:flex;align-items:center;font-size:24rpx;color:#7b877f}.consent-row checkbox{transform:scale(.8)}.privacy-link{background:transparent;font-size:24rpx;color:#285b4b;line-height:1.6;margin:0;padding:0}.privacy-copy{font-size:25rpx;color:#6c7a72;line-height:1.8;margin-top:24rpx}.cancel{background:transparent;font-size:27rpx;color:#7b877f;margin-top:34rpx}button::after{border:0}
.login-page > button.login-primary{width:100%;max-width:none;display:block}
.login-page .privacy-link{width:auto;max-width:none;display:inline-block;flex:none;margin:0;padding:0}
