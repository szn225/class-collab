page{background:#fafaf7;color:#243a31}.login-page{padding:100rpx 48rpx}.login-symbol{width:96rpx;height:96rpx;line-height:96rpx;text-align:center;background:#245d50;color:#fff;border-radius:28rpx;font-size:24px;margin-bottom:48rpx}.login-title{font-size:24px;font-weight:600;line-height:1.4}.login-note{font-size:15px;line-height:1.8;color:#65736b;margin:22rpx 0 64rpx}.login-primary{width:100%;height:100rpx;line-height:100rpx;border-radius:24rpx;background:#245d50;color:#fff;font-size:17px}.login-error{color:#aa4c32;font-size:15px;line-height:1.6;margin:24rpx 0}checkbox-group{display:flex;justify-content:center;align-items:center;margin-top:24rpx}.consent-row{display:flex;align-items:center;font-size:15px;color:#65736b}.consent-row checkbox{transform:scale(.8)}.privacy-link{background:transparent;font-size:15px;color:#245d50;line-height:1.6;margin:0;padding:0}.privacy-copy{font-size:15px;color:#6c7a72;line-height:1.8;margin-top:24rpx}.cancel{background:transparent;font-size:15px;color:#65736b;margin-top:34rpx}button::after{border:0}
.login-page > button.login-primary{width:100%;max-width:none;display:block}
.login-page .privacy-link{width:auto;max-width:none;display:inline-block;flex:none;margin:0;padding:0}

.nav-account{padding:8px 4px;font-size:15px;color:#4e6b54}.hub{padding-top:30rpx}.account{padding-top:36rpx}.page{padding-top:20rpx}

/* 2.3.1 — readable type hierarchy; keep layout flexible. */
.login-page{padding:40px 20px}.login-title{font-size:24px;line-height:1.35}.login-note,.privacy-copy{font-size:17px;line-height:1.65;color:#465d56}.login-primary{font-size:17px;height:52px;line-height:52px}.consent-row,.privacy-link{font-size:15px;line-height:1.5;min-height:44px}.privacy-link{display:flex;align-items:center}.login-page checkbox-group{flex-wrap:wrap;justify-content:flex-start;gap:4px}.cancel{font-size:17px;line-height:1.5;min-height:48px;padding:12px}.login-error{font-size:17px;line-height:1.5}
