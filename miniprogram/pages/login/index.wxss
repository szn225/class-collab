page{background:var(--ui-bg)}
.login-page{padding:48px 24px}.login-symbol{display:block;width:48px;height:48px;margin-bottom:28px}
.login-title{font-size:22px;line-height:1.4;font-weight:600}.login-note{font-size:16px;line-height:1.75;color:var(--ui-muted);margin:12px 0 32px}
.login-page>button.login-primary{display:flex;align-items:center;justify-content:center;width:100%;max-width:none;min-height:48px;padding:12px 16px;line-height:24px;border:1px solid var(--ui-green);border-radius:10px;background:var(--ui-green);color:#fff;font-size:16px}
.login-error{color:var(--ui-danger);background:var(--ui-danger-soft);padding:12px;border-radius:10px;font-size:15px;margin:16px 0}
.login-page checkbox-group{display:flex;align-items:center;flex-wrap:wrap;gap:4px;margin-top:16px}.consent-row{display:flex;align-items:center;font-size:15px;color:var(--ui-muted);min-height:44px}.consent-row checkbox{transform:scale(.8)}
.login-page .privacy-link{display:flex;align-items:center;width:auto;max-width:none;min-height:44px;padding:0;background:transparent;color:var(--ui-green);font-size:15px;margin:0}
.privacy-copy{font-size:15px;color:var(--ui-muted);line-height:1.8;margin-top:16px}
.cancel{min-height:44px;background:transparent;color:var(--ui-muted);font-size:15px;padding:10px;margin-top:16px}button::after{border:0}
.login-page .login-primary{display:flex;align-items:center;justify-content:center;width:100%;max-width:none;min-height:48px;padding:12px 16px;line-height:24px;border:1px solid var(--ui-green);border-radius:10px;background:var(--ui-green);color:#fff;font-size:16px}
.login-page .profile-avatar{display:flex;align-items:center;justify-content:center;width:80px;height:80px;min-height:80px;padding:0;margin:0 auto;overflow:hidden;border:1px solid var(--ui-green-line);border-radius:50%;background:var(--ui-green-soft)}.profile-avatar image{width:100%;height:100%;display:block}.avatar-label{text-align:center;color:var(--ui-green);font-size:15px;margin:12px 0 28px}.profile-field{font-size:15px;margin-bottom:28px}.profile-field input{height:48px;line-height:48px;border-bottom:1px solid var(--ui-line);font-size:17px;margin-top:8px}.profile-privacy{font-size:14px;line-height:1.7;color:var(--ui-muted);margin-top:24px}

.login-page .avatar-picker{display:flex;flex-direction:column;align-items:center;justify-content:center;width:100%;min-height:124px;padding:8px 12px;margin:0;background:transparent;border:0;line-height:1.5}.avatar-picker .profile-avatar{flex:none;margin:0}.avatar-picker .avatar-label{margin:12px 0 0;font-size:16px}.login-page .album-picker{display:flex;align-items:center;justify-content:center;width:auto;min-height:44px;margin:0 auto 24px;padding:8px 16px;background:transparent;color:var(--ui-green);border:0;font-size:15px}

.profile-probe{padding:16px;border:1px solid var(--ui-line);border-radius:12px;margin-bottom:24px}.profile-probe .login-note{margin:12px 0;font-size:15px}.probe-result{font-size:15px;line-height:1.7;overflow-wrap:break-word}.probe-avatar{display:block;width:64px;height:64px;border-radius:50%;margin:12px 0}

.profile-progress{display:flex;justify-content:space-between;gap:12px;padding:12px 14px;margin-bottom:16px;border-radius:10px;background:var(--ui-green-soft);color:var(--ui-muted);font-size:14px;line-height:1.6}.profile-ready{color:var(--ui-green)}.nickname-label{display:flex;align-items:center;justify-content:space-between;gap:12px}.login-page .nickname-shortcut{width:auto;min-height:44px;margin:0;padding:8px 0 8px 12px;background:transparent;color:var(--ui-green);font-size:15px;line-height:28px}

/* 个人资料页：居中头像、名字输入和单一保存操作。 */
.login-page.profile-page{padding:40px 24px}.profile-page .avatar-picker{min-height:128px;padding:0;margin:0 0 40px}.profile-page .profile-avatar{width:68px;height:68px;min-height:68px;border-radius:16px}.profile-page .avatar-picker .avatar-label{margin:14px 0 0;font-size:15px;color:var(--ui-muted)}.profile-page .profile-field{margin-bottom:32px}.profile-page .nickname-label>text{font-size:16px;font-weight:600}.profile-page .nickname-shortcut{font-size:15px;color:var(--ui-muted);font-weight:400}.profile-page .profile-field input{margin-top:8px}.profile-page .login-primary{margin:0}
