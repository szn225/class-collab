<view class="login-page">
 <view class="login-symbol">慧</view>
 <view class="login-title">{{saveId ? '登录后保存这次成绩' : '登录慧共创'}}</view>
 <view class="login-note">{{saveId ? '已填内容会保留，登录后继续保存。' : '用微信账号保存和管理你的内容。'}}</view>
 <view wx:if="{{error}}" class="login-error">{{error}}</view>
 <button class="login-primary" bindtap="login" loading="{{busy}}" disabled="{{busy}}">{{signedIn ? (saveId ? '继续保存' : '继续') : (saveId ? '微信登录并保存' : '微信登录')}}</button>
 <checkbox-group wx:if="{{!signedIn}}" bindchange="consent"><label class="consent-row"><checkbox value="yes" checked="{{consent}}" color="#285b4b"/>已阅读并同意</label><button class="privacy-link" bindtap="privacy">隐私说明</button></checkbox-group>
 <view wx:if="{{privacy}}" class="privacy-copy">微信身份用于关联账号，不获取手机号、头像或昵称。成绩默认保存在本机，主动开启云端同步后保存到个人账号，不向活动成员公开。</view>
 <button class="cancel" bindtap="cancel" disabled="{{busy}}">{{saveId ? '返回继续填写' : '暂不登录'}}</button>
</view>
