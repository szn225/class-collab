<app-nav title="{{profileStep ? '个人资料' : '登录'}}" show-back="{{true}}"/>
<view class="login-page {{profileStep ? 'profile-page' : ''}}">
 <block wx:if="{{profileStep}}">
  <view wx:if="{{profileProbe}}" class="profile-probe"><button class="login-primary" bindtap="probeWechatProfile" loading="{{probeBusy}}" disabled="{{busy || probeBusy}}">验证微信头像昵称授权</button><view class="login-note">本次只显示微信返回结果，不保存或覆盖你的个人资料。</view><view wx:if="{{probeResult}}" class="probe-result" aria-live="polite">{{probeResult}}</view><image wx:if="{{probeAvatar}}" class="probe-avatar" src="{{probeAvatar}}" mode="aspectFill"/><view wx:if="{{probeNickname}}" class="probe-result">微信返回昵称：{{probeNickname}}</view></view>
  <form bindsubmit="saveProfile">

   <button wx:if="{{avatarPickerSupported}}" class="avatar-picker" open-type="chooseAvatar" bindchooseavatar="chooseAvatar" binderror="avatarPickerError" disabled="{{busy || choosingAvatar}}" aria-label="选择微信头像"><view class="profile-avatar"><image wx:if="{{avatarPreview && !avatarBroken}}" src="{{avatarPreview}}" mode="aspectFill" binderror="avatarError"/><ui-icon wx:else name="person" size="32px" tone="accent"/></view><view class="avatar-label">{{avatarPreview ? '更换头像' : '使用微信头像'}}</view></button>
   <button wx:else class="avatar-picker" bindtap="chooseAvatarFromAlbum" disabled="{{busy || choosingAvatar}}" aria-label="从相册选择头像"><view class="profile-avatar"><image wx:if="{{avatarPreview && !avatarBroken}}" src="{{avatarPreview}}" mode="aspectFill" binderror="avatarError"/><ui-icon wx:else name="person" size="32px" tone="accent"/></view><view class="avatar-label">选择头像</view></button>

   <view class="profile-field"><view class="nickname-label"><text>名字</text><button class="nickname-shortcut" bindtap="useWechatNickname" disabled="{{busy || choosingAvatar}}">使用微信昵称</button></view><input focus="{{nicknameFocus}}" name="nickname" type="nickname" value="{{nickname}}" maxlength="30" bindinput="nicknameInput" bindblur="nicknameBlur" bindnicknamereview="nicknameReview" disabled="{{busy || choosingAvatar}}" placeholder="请输入你的名字" placeholder-class="input-placeholder"/></view>
   <view wx:if="{{error}}" class="login-error">{{error}}</view>
   <button class="login-primary" form-type="submit" loading="{{busy}}" disabled="{{busy || choosingAvatar || (!nickname && !avatarPreview)}}">{{reviewing ? '正在确认昵称' : '保存资料'}}</button>
  </form>
  <button wx:if="{{saveId && !editingProfile}}" class="cancel" bindtap="skipProfile" disabled="{{busy || choosingAvatar}}">{{editingProfile ? '取消修改' : (saveId ? '跳过，继续保存成绩' : '暂时跳过')}}</button>
 </block>
 <block wx:else>
  <image class="login-symbol" src="/assets/ui/huigongchuang-logo.png" mode="aspectFit" aria-label="慧共创 Logo"/>
  <view class="login-title">{{saveId ? '登录后保存这次成绩' : '登录慧共创'}}</view>
  <view class="login-note">{{saveId ? '已填内容会保留，登录后继续保存。' : '用微信账号保存和管理你的内容。'}}</view>
  <view wx:if="{{error}}" class="login-error">{{error}}</view>
  <button class="login-primary" bindtap="login" loading="{{busy}}" disabled="{{busy || choosingAvatar}}">{{signedIn ? (saveId ? '继续保存' : '继续') : (saveId ? '微信登录并保存' : '微信登录')}}</button>
  <checkbox-group wx:if="{{!signedIn}}" bindchange="consent"><label class="consent-row"><checkbox value="yes" checked="{{consent}}" color="#285b4b"/>已阅读并同意</label><button class="privacy-link" bindtap="privacy">隐私说明</button></checkbox-group>
  <button wx:if="{{saveId}}" class="cancel" bindtap="cancel" disabled="{{busy || choosingAvatar}}">返回继续填写</button>
 </block>
 <view wx:if="{{privacy}}" class="privacy-copy">微信身份用于关联账号，不获取手机号。头像和昵称由你主动选择、填写并保存，用于个人资料展示；共创活动使用你的显示昵称。成绩默认保存在本机，主动开启云端同步后保存到个人账号，不向活动成员公开。</view>
</view>
