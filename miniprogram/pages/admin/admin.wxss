.profile {
  margin-top: 32rpx;
  background: #ddf3e8;
  border-color: #c2e5d4;
}
.profile .tag {
  display: inline-block;
  margin-top: 8rpx;
  background: white;
}
.member-art {
  width: 140rpx;
  height: 140rpx;
  margin-bottom: 24rpx;
}
.card > .muted {
  margin: 20rpx 0 32rpx;
}
.manage-title {
  font-size: 34rpx;
  font-weight: 600;
  word-break: break-all;
  margin-top: 24rpx;
}
.manage-actions {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
  margin-top: 28rpx;
}
.manage-actions button {
  flex: 1;
  min-width: 200rpx;
}
.topic-picker {
  background: #eef3ff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-top: 24rpx;
  font-size: 28rpx;
  color: #2457d6;
  min-height: 88rpx;
}
.member-row {
  padding: 24rpx 0;
  border-bottom: 2rpx solid #e8ebef;
}
.member-row:last-child {
  border: 0;
}
.member-row .avatar {
  width: 64rpx;
  height: 64rpx;
  font-size: 26rpx;
}
.modal-overlay {
  position: fixed;
  inset: 0;
  background: rgba(20, 35, 58, 0.4);
  display: flex;
  align-items: flex-end;
  z-index: 10;
}
.create-sheet {
  width: 100%;
  max-height: 90vh;
  overflow-y: auto;
  background: #fffdf7;
  border-radius: 32rpx 32rpx 0 0;
  padding: 32rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
}
.description-input {
  height: 180rpx;
  margin-bottom: 28rpx;
}
