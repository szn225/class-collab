<view class="page">
  <view class="row spread">
    <text class="eyebrow">把回忆，写成故事</text>
    <image class="icon" src="/images/campus/notebook.png" />
  </view>
  <view class="page-title">班级故事集</view>
  <state-panel
    wx:if="{{error}}"
    title="文章暂时无法加载"
    description="{{error}}"
    action="重新加载"
    bind:action="loadArticle"
  />
  <skeleton-list wx:if="{{loading && !article}}" />
  <block wx:if="{{article}}">
    <view class="article-paper">
      <view class="paper-label">我们的班级 · 共同创作</view>
      <view class="article-title">{{article.title}}</view>
      <view class="small article-meta">
        {{article.createdAtText}}
        <text wx:if="{{countKnown}}">· 基于 {{materialCount}} 条素材生成</text>
      </view>
      <view class="line"></view>
      <rich-text nodes="{{displayHtml}}" class="article-rich" selectable />
    </view>
    <view class="card publish-card">
      <view class="section-title">把故事分享出去</view>
      <view class="muted">复制链接，在浏览器中打开并获取文章正文。</view>
      <button class="button-primary" bindtap="copyURL" disabled="{{copying}}">复制预览链接</button>
      <text wx:if="{{previewUrl}}" class="url-box" selectable="true">{{previewUrl}}</text>
      <button class="button-plain guide-toggle" bindtap="toggleGuide">
        {{guideOpen ? '收起发布指南 ↑' : '查看公众号发布指南 ↓'}}
      </button>
      <view wx:if="{{guideOpen}}">
        <view wx:for="{{steps}}" wx:key="index" class="guide-step row">
          <text class="step-number">{{index + 1}}</text>
          <text class="grow">{{item}}</text>
        </view>
      </view>
    </view>
  </block>
  <state-panel
    wx:if="{{!loading && !error && !article}}"
    title="故事正在酝酿中"
    description="文章尚未生成，请联系管理员整理素材并生成文章"
  />
</view>
