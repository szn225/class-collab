<app-nav title="慧共创" show-home="{{false}}"/>
<image class="hub-background" src="/assets/redesign/contour-bg.jpg" mode="aspectFill" aria-hidden="true"/>
<view class="hub">
 <view class="account-summary">
  <button class="identity-entry" bindtap="account" aria-label="查看个人账号"><view class="account-avatar"><image wx:if="{{user.avatarUrl && !avatarBroken}}" src="{{user.avatarUrl}}" mode="aspectFill" binderror="avatarError"/><ui-icon wx:else name="person" size="24px" tone="accent"/></view><view class="identity-copy"><view class="account-name">{{user ? (user.name || '微信用户') : '访客'}}</view><view class="account-status">{{user ? '已登录' : '未登录'}}</view></view></button>
  <button wx:if="{{!user}}" class="signin-link" bindtap="signIn">登录<ui-icon name="chevron-right" size="18px" tone="accent"/></button>
  <button wx:else class="account-settings" bindtap="account" aria-label="账号设置"><ui-icon name="settings" size="22px"/></button>
 </view>
 <button class="entry-card collab" bindtap="coCreate" aria-label="进入活动文章共创">
  <image class="entry-art" src="/assets/redesign/collab-article-line.png" mode="aspectFit" aria-hidden="true"/>
  <view class="tool-copy"><view class="entry-title">活动文章共创</view><view class="entry-note">收集图文，一起成文</view><view class="entry-action"><text>开始共创</text><ui-icon name="chevron-right" size="18px" tone="accent"/></view></view>
 </button>
 <button class="entry-card grades" bindtap="grades" aria-label="进入成绩追踪助手">
  <image class="entry-art" src="/assets/redesign/grades-line.png" mode="aspectFit" aria-hidden="true"/>
  <view class="tool-copy"><view class="entry-title">成绩追踪助手</view><view class="entry-note">记录成绩，看见进步</view><view class="entry-action"><text>记录与查看</text><ui-icon name="chevron-right" size="18px" tone="default"/></view></view>
 </button>
</view>
