page{background:#f5f6f2;color:#243b30}.hub{padding:52rpx 36rpx 56rpx;display:flex;flex-direction:column;gap:30rpx}.entry-card{position:relative;width:100%;margin:0;padding:42rpx 38rpx;text-align:left;white-space:normal;border:1px solid #e1e6dd;border-radius:32rpx;min-height:318rpx;box-shadow:0 12rpx 36rpx rgba(39,61,44,.035);overflow:hidden}.entry-card::after{border:0}.collab{background:#fffef9}.grades{background:#e8f0e8;border-color:#dce7dc}.entry-icon{display:flex;align-items:center;justify-content:center;width:86rpx;height:86rpx;border-radius:25rpx;margin-bottom:34rpx}.paper-icon{background:#ece9dc;flex-direction:column;gap:8rpx}.paper-icon view{height:4rpx;width:34rpx;background:#7b765c;border-radius:3rpx}.paper-icon view:last-child{width:22rpx;align-self:flex-start;margin-left:26rpx}.chart-icon{background:#d4e3d5;align-items:flex-end;padding:22rpx;gap:7rpx}.chart-icon view{width:9rpx;background:#3c6b4b;border-radius:5rpx}.chart-icon view:nth-child(1){height:18rpx}.chart-icon view:nth-child(2){height:29rpx}.chart-icon view:nth-child(3){height:42rpx}.entry-title{font-size:40rpx;font-weight:600;line-height:1.4;letter-spacing:1rpx}.entry-note{font-size:26rpx;color:#82907f;line-height:1.8;margin-top:12rpx}.entry-arrow{position:absolute;right:36rpx;bottom:42rpx;font-size:46rpx;line-height:64rpx;text-align:center;width:64rpx;height:64rpx;border:1px solid #d8e1d3;border-radius:50%;color:#52715a;background:rgba(255,255,255,.45)}
.hub > button.entry-card{width:100%;max-width:none;display:block;flex-shrink:0}.entry-note{font-weight:400}

.hub-heading{display:flex;align-items:center;justify-content:space-between;font-size:34rpx;font-weight:600}.hub-heading button{margin:0;padding:0 16rpx;background:transparent;color:#52715a;font-size:28rpx}.hub-heading button::after{border:0}
