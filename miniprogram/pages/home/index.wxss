page{background:#fafaf7;color:#263b37}.hub{padding:48rpx;display:flex;flex-direction:column;gap:28rpx}.section-label{font-size:24rpx;color:#65736b;margin:8rpx 0 2rpx}.entry-card{position:relative;width:100%;max-width:none;display:block;margin:0;padding:38rpx;text-align:left;border:0;border-radius:32rpx;font-weight:400;white-space:normal;overflow:hidden}.collab{background:#f7f0e6}.grades{background:#edf2f7}.entry-art{position:absolute;right:26rpx;top:34rpx;width:136rpx;height:136rpx}.entry-symbol{position:absolute;right:48rpx;top:60rpx;width:72rpx;height:72rpx}.entry-title{font-size:38rpx;font-weight:600;color:#263b37;padding-right:90rpx;line-height:1.5}.entry-note{margin-top:16rpx;font-size:25rpx;color:#65736b;padding-right:68rpx;line-height:1.7}.entry-action{margin-top:68rpx;font-size:26rpx;color:#245d50;display:flex;align-items:center;justify-content:space-between}.entry-action text{font-size:36rpx;line-height:1}.account-entry{margin:40rpx 0 0;padding:24rpx 0;display:flex;align-items:center;gap:24rpx;width:100%;max-width:none;background:transparent;border-radius:0;border-bottom:1rpx solid #e2e8e2;min-height:100rpx;font-size:27rpx;color:#263b37;font-weight:500}.account-entry image{width:36rpx;height:36rpx}.chevron{margin-left:auto;color:#65736b;font-weight:400}.entry-card:active,.account-entry:active{opacity:.8}
.hub>button.entry-card,.hub>button.account-entry{width:100%;max-width:none;flex-shrink:0}.hub>button.entry-card{display:block}.hub>button.account-entry{display:flex}
