page{background:#f6f7f4;color:#213d32}.hub{padding:32rpx 36rpx 64rpx;display:flex;flex-direction:column;gap:24rpx}.hub-heading{display:flex;align-items:center;justify-content:space-between}.hub-heading>view{display:flex;align-items:center;gap:16rpx;font-size:30rpx;font-weight:600}.brand-mark{width:54rpx;height:54rpx;line-height:54rpx;background:#244e40;color:#fff;text-align:center;border-radius:16rpx;font-size:28rpx}.hub-heading button{margin:0;padding:0 24rpx;background:#fff;color:#4f665a;border-radius:40rpx;font-size:25rpx;line-height:72rpx;border:1rpx solid #e2e8e1}.hub-heading button::after,button.entry-card::after{border:0}.hub-intro{padding:32rpx 4rpx 24rpx}.eyebrow{font-size:22rpx;letter-spacing:5rpx;color:#728379;margin-bottom:20rpx}.hub-title{font-size:48rpx;line-height:1.45;font-weight:600;letter-spacing:1rpx}.entry-card{position:relative;width:100%;max-width:none;display:block;margin:0;padding:32rpx;text-align:left;white-space:normal;border:1rpx solid #e2e7df;border-radius:32rpx;overflow:hidden;box-shadow:0 8rpx 24rpx rgba(29,57,39,.025)}.collab{background:#fffefa}.grades{background:#e9f0ea;border-color:#dce6dd}.entry-icon{position:absolute;right:32rpx;top:32rpx;width:64rpx;height:64rpx;border-radius:20rpx;display:flex;align-items:center;justify-content:center}.paper-icon{background:#f1ecdf;flex-direction:column;gap:7rpx}.paper-icon view{width:26rpx;height:3rpx;background:#8f8164;border-radius:3rpx}.paper-icon view:last-child{width:18rpx}.chart-icon{background:#d5e3d8;align-items:flex-end;padding:17rpx;gap:5rpx;box-sizing:border-box}.chart-icon view{width:7rpx;background:#527b61;border-radius:3rpx}.chart-icon view:nth-child(1){height:13rpx}.chart-icon view:nth-child(2){height:22rpx}.chart-icon view:nth-child(3){height:30rpx}.entry-title{padding-right:70rpx;font-size:34rpx;line-height:1.6;font-weight:600}.entry-note{margin-top:12rpx;color:#687c6d;font-size:24rpx;line-height:1.7}.entry-action{display:flex;justify-content:space-between;align-items:center;margin-top:32rpx;padding-top:22rpx;border-top:1rpx solid rgba(67,99,76,.12);font-size:24rpx;color:#3b6450}.entry-action text{font-size:32rpx}button.entry-card:active{opacity:.85}
.hub > button.entry-card{width:100%;max-width:none;display:block;flex-shrink:0;color:#213d32;font-weight:400}.hub-heading > button{width:auto;flex:none;max-width:none;font-weight:400}.entry-note,.entry-action{font-weight:400}
