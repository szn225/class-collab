page{background:var(--ui-bg);color:var(--ui-ink)}
.hub{position:relative;z-index:1;padding:16px 20px calc(40px + env(safe-area-inset-bottom));display:flex;flex-direction:column;gap:16px;min-height:calc(100vh - 88px)}
.account-summary{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:0 0 20px;margin-bottom:6px;border-bottom:1px solid var(--ui-line)}
.account-summary>button{max-width:none;margin:0;padding:0;background:transparent;border:0;border-radius:8px;color:var(--ui-ink)}
.account-summary>button.identity-entry{justify-content:flex-start;gap:12px;width:auto;flex:1;min-width:0;min-height:48px;text-align:left}
.account-avatar{display:flex;align-items:center;justify-content:center;width:40px;height:40px;border:1px solid var(--ui-line);border-radius:50%;background:var(--ui-green-soft);flex:none}
.identity-copy{min-width:0}.account-name{font-size:16px;line-height:1.5;font-weight:600;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.account-status{font-size:15px;color:var(--ui-muted);font-weight:400}
.account-summary>button.signin-link{width:auto;gap:4px;min-height:44px;font-size:15px;color:var(--ui-green);flex:none}
.account-summary>button.account-settings{width:44px;height:44px;flex:none}
.hub>button.entry-card{position:relative;display:flex;align-items:center;justify-content:flex-start;width:100%;max-width:none;min-height:150px;margin:0;padding:18px 20px;border:1px solid var(--ui-green-line);border-radius:16px;background:var(--ui-green-soft);text-align:left;overflow:hidden;color:var(--ui-green);box-shadow:none}
.hub>button.grades{background:var(--ui-blue-soft);border-color:var(--ui-blue-line);color:var(--ui-blue)}
.entry-art{position:absolute;right:-12px;bottom:0;width:58%;height:154px;pointer-events:none}
.tool-copy{position:relative;z-index:1;min-width:0;width:100%}
.entry-title{font-size:19px;line-height:1.4;font-weight:600;max-width:100%}
.entry-note{margin-top:6px;font-size:15px;color:var(--ui-secondary);font-weight:400}
.entry-action{display:flex;align-items:center;gap:5px;min-height:44px;margin-top:12px;font-size:15px;font-weight:500;width:max-content}
@media(max-width:350px){.hub{padding-left:16px;padding-right:16px}.hub>button.entry-card{padding:20px 16px}.entry-art{width:41%;opacity:.55}.entry-title{font-size:18px}}

.hub-background{position:fixed;left:0;top:0;width:100%;height:100vh;z-index:0;pointer-events:none}

.collab .entry-art{right:0;width:50%;height:142px}
