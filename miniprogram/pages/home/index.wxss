page{background:#fff;color:#263b37}.hub{padding:20px;display:flex;flex-direction:column;gap:16px}.account-summary{display:flex;align-items:center;justify-content:space-between;gap:16px;margin-bottom:12px;padding:4px 0 20px;border-bottom:1px solid #e6e9ed}.account-summary>button{max-width:none;margin:0;padding:0;background:transparent;color:#263b37;border:0;font-weight:400}.account-summary>button.identity-entry{display:flex;align-items:center;gap:12px;width:auto;min-width:0;flex:1;text-align:left;min-height:52px}.account-avatar{display:flex;align-items:center;justify-content:center;flex:none;width:44px;height:44px;border-radius:14px;background:#f5f6f8}.account-avatar image{width:24px;height:24px}.identity-copy{min-width:0}.account-name{font-size:17px;line-height:1.5;font-weight:500;overflow:hidden;white-space:nowrap;text-overflow:ellipsis}.account-status{font-size:15px;line-height:1.5;color:#65736b;margin-top:2px}.account-summary>button.signin-link{display:flex;width:auto;flex:none;align-items:center;gap:6px;min-height:44px;padding:8px 0 8px 12px;color:#245d50;font-size:17px;line-height:1.5}.account-summary>button.account-settings{display:flex;align-items:center;justify-content:center;width:44px;height:44px;flex:none}.account-settings image{width:22px;height:22px}.hub>button.entry-card{display:flex;align-items:center;width:100%;max-width:none;min-height:116px;margin:0;padding:20px 16px;border:1px solid #e6e9ed;border-radius:16px;background:#fff;gap:14px;text-align:left;white-space:normal;font-weight:400;box-shadow:0 2px 10px rgba(24,39,50,.025)}.tool-icon{width:44px;height:44px;display:flex;align-items:center;justify-content:center;border-radius:12px;flex:none}.tool-icon image{width:26px;height:26px}.collab-icon{background:#f7f0e6}.grades-icon{background:#edf2f7}.tool-copy{flex:1;min-width:0}.entry-title{font-size:20px;line-height:1.4;font-weight:500;color:#263b37}.entry-note{font-size:15px;line-height:1.5;color:#65736b;margin-top:8px}.chevron-icon{width:18px;height:18px;flex:none}.entry-card:active,.identity-entry:active{opacity:.8}@media(max-width:350px){.hub>button.entry-card{padding:18px 12px;gap:10px}.tool-icon{width:36px;height:36px}.entry-title{font-size:20px}}
.account-summary>button.identity-entry{justify-content:flex-start}
