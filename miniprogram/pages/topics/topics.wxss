.join-card {
  margin-top: 32rpx;
  background: #e9efff;
  border-color: #d2ddf8;
}
.join-card .field-label {
  margin-top: 0;
}
.join-card .input-field {
  background: white;
}
.filters {
  display: flex;
  gap: 8rpx;
  margin-bottom: 24rpx;
}
.filter {
  flex: 1;
  padding: 16rpx 8rpx;
  min-height: 88rpx;
  font-size: 26rpx;
  background: transparent;
  color: #59677d;
}
.filter.selected {
  background: #2457d6;
  color: white;
}
.topic-icon {
  width: 64rpx;
  height: 64rpx;
}
.topic-title {
  font-size: 34rpx;
  font-weight: 600;
  line-height: 1.5;
  margin: 20rpx 0 12rpx;
  overflow-wrap: break-word;
  word-break: break-all;
}
.topic-description {
  font-size: 28rpx;
  color: #59677d;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.topic-card:nth-child(3n) {
  border-top: 6rpx solid #ffd66b;
}
