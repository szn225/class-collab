page { background:#ffffff; color:#263b37; font-family:-apple-system,'PingFang SC',sans-serif; font-size:15px; line-height:1.6; }
view,button,input,textarea,image,scroll-view { box-sizing:border-box; }
button::after { border:0; }
button[disabled] { opacity:.45; }

/* 2.3.1 — readable type hierarchy; keep layout flexible. */
page{font-size:17px;line-height:1.55;color:#263b37}button,input,textarea{font-family:inherit}button{font-weight:500}
