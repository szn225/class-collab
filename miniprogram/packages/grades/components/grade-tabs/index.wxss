/* 兜底：self 作用域直接引入 Token。app.wxss 经 apply-shared 已能作用到本组件，
 * 但自定义 TabBar 由框架在 <page> 之外单独渲染，为避免宿主样式注入差异导致
 * var() 再次失效，这里再引一次 Token —— 引的是同源生成的 scope 版
 * （design-tokens-scope.wxss，只含 .token-scope 一条类选择器规则，数值仍单调自
 * design-tokens.wxss）。不能直接引 design-tokens.wxss：组件 wxss 禁用标签选择器，
 * 它的 `page, .token-scope` 会把 `page` 带进来并触发开发者工具告警。 */
@import "../../styles/design-tokens-scope.wxss";

.tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  display: flex;
  /* 不依赖全局 view{box-sizing:border-box} 的注入，避免安全区被算两次 */
  box-sizing: border-box;
  /* 总高 = 56 内容区 + 安全区。工程内 view{box-sizing:border-box}，
   * 若写死 height:56px 会把安全区内边距算进 56 里，有 Home Indicator 的机型
   * 内容区只剩 22px，图标文字被压到贴边。与 app.wxss 的 .tabbar-spacer 同值。 */
  min-height: calc(56px + env(safe-area-inset-bottom));
  padding-bottom: env(safe-area-inset-bottom);
  background: var(--surface);
  border-top: var(--border-width) solid var(--border);
  /* 组件在 page 之外，不继承 page 的字体，需显式声明 */
  font-family: var(--font-body);
}
.tab {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 2px;
  color: var(--muted);
  transition: color var(--motion-base) var(--ease-standard);
}
.tab.on {
  color: var(--accent);
}
.tab.on .tab-txt {
  font-weight: 590;
}
.tab-ic {
  height: 24px;
  line-height: 0;
}
.tab-txt {
  font-size: var(--text-xs);
  /* 已对齐 token 阶梯：--leading-xs = 1.4（原 1.2 为刻意收紧，现统一系统） */
  line-height: var(--leading-xs);
}

.tabbar{background:#fff;border-top:1px solid #e6ebdf;min-height:calc(58px + env(safe-area-inset-bottom))}.tab{min-height:58px;gap:3px}.tab-ic{height:22px}.tab-txt{font-size:15px}.tab.on .tab-ic{background:#e9f0e3;border-radius:9px;min-width:36px;text-align:center;padding:1px 3px;height:26px}.tab.on{color:#245d50}

.tabbar{border-top:1px solid #e2e8e2}.tab.on .tab-ic{background:transparent;padding:0;height:24px;min-width:24px}.tab-ic{height:24px}.tab-txt{font-size:15px}.tab.on{color:#245d50}

/* 2.3.1 — readable type hierarchy; keep layout flexible. */
.tabbar{min-height:calc(68px + env(safe-area-inset-bottom))}.tab{min-height:68px;gap:5px}.tab-txt{font-size:15px;line-height:1.4;font-weight:400}.tab.on .tab-txt{font-weight:600}.tab-ic{height:24px}
