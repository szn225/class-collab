.tabbar{position:fixed;left:0;right:0;bottom:0;z-index:100;display:flex;box-sizing:border-box;height:calc(52px + min(20px, env(safe-area-inset-bottom)));min-height:calc(52px + min(20px, env(safe-area-inset-bottom)));padding-bottom:min(20px, env(safe-area-inset-bottom));background:#fff;border-top:1px solid #e6e9ed;font-family:var(--font-body)}.tab{flex:1;min-width:0;height:52px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:2px;color:#65736b}.tab.on{color:#245d50}.tab-ic{height:22px;line-height:0}.tab-txt{font-size:15px;line-height:20px;font-weight:400}.tab.on .tab-txt{font-weight:500}
