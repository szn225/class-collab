.hero {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  /* 对齐 375 设计稿 .hero：gap 6、padding 16/16/14 */
  gap: 6px;
  background: var(--accent-subtle);
  border: var(--border-width) solid var(--border);
  border-radius: var(--radius-lg);
  padding: 16px 16px 14px;
}
.hero-k {
  font-size: var(--text-sm);
  line-height: var(--leading-sm);
  color: var(--muted);
  letter-spacing: 0.01em;
}
.hero-v {
  font-size: var(--text-4xl);
  line-height: var(--leading-display);
  font-weight: 590;
  letter-spacing: -0.01em;
  color: var(--fg);
}
.hero-u {
  font-size: var(--text-lg);
  font-weight: 510;
  color: var(--muted);
  margin-left: 4px;
  letter-spacing: 0;
}
.hero-chips {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  flex-wrap: wrap;
  margin-top: var(--space-1);
}
.hero-sub {
  margin-top: var(--space-1);
  font-size: var(--text-base);
  line-height: var(--leading-base);
  color: var(--fg-2);
}

.hero{padding:24px;border-radius:22px;border-color:#dce6d7;background:linear-gradient(135deg,#e9f1e4,#e0ecdf);gap:8px}.hero-k{font-size:12px;letter-spacing:1px}.hero-v{font-size:46px;line-height:1.2;color:#244832}.hero-sub{font-size:13px}

.hero{padding:20px;border:0;border-radius:16px;background:#edf2f7;gap:6px}.hero-k{font-size:13px;color:#55758d;letter-spacing:0}.hero-v{font-size:42px;color:#263b37;line-height:1.2}.hero-sub{font-size:13px;color:#65736b}.hero-chips{margin-top:2px}
