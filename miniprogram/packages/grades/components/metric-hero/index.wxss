.hero{display:flex;flex-direction:column;align-items:flex-start;gap:8px;padding:20px;border:1px solid var(--border);border-radius:var(--radius-lg);background:var(--data-subtle)}
.hero-k{font-size:var(--text-sm);line-height:1.5;color:var(--data)}.hero-v{font-size:var(--text-4xl);line-height:1.2;font-weight:600;color:var(--fg);letter-spacing:-.01em}.hero-u{font-size:var(--text-base);font-weight:400;color:var(--muted);margin-left:4px}.hero-chips{display:flex;align-items:center;flex-wrap:wrap;gap:8px;margin-top:4px}.hero-sub{font-size:var(--text-base);line-height:1.6;color:var(--fg-2)}
