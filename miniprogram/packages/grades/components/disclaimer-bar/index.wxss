.disclaim {
  border-top: var(--border-width) solid var(--border-soft);
  padding-top: var(--space-3);
  display: flex;
  flex-direction: column;
  gap: var(--space-1);
}
.disclaim-h {
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: var(--text-xs);
  font-weight: 510;
  color: var(--fg-2);
}
.disclaim-b {
  font-size: var(--text-xs);
  color: var(--muted);
  line-height: var(--leading-body);
}
