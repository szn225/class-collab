/* Generated from design-tokens.wxss. */
.token-scope {
  /* ---------- A1-identity ---------- */
  /* 表面层 */
  --bg: #FFFFFF;
  --surface: #FFFFFF;
  --surface-2: #F5F6F8;
  /* 前景层 */
  --fg: #263B37;
  --fg-2: #465D56;
  --muted: #65736B;
  /* --meta #98A2A5 仅作装饰 / ≥18px 大字；小字占位改走 --muted（2.43:1 未达 AA） */
  --meta: #98A2A5;
  /* 边框层 */
  --border: #E6E9ED;
  --border-soft: #EDF0EB;
  --border-width: 1px;
  /* 强调色（沉青，已加深至 AA：白字 4.58:1 / onSurf 4.58:1） */
  --accent: #245D50;
  --accent-hover: #244E40;
  --accent-active: #1C4334;
  --accent-subtle: #EDF3EE;
  --accent-on: #FFFFFF;

  --data: #4D6B82;
  --data-subtle: #EDF2F7;
  --review: #756683;
  --review-subtle: #F0EDF5;
  /* 字体 */
  --font-body: "PingFang SC", "HarmonyOS Sans SC", "MiSans", "Source Han Sans SC", "Noto Sans SC", "Microsoft YaHei", -apple-system, sans-serif;
  --font-display: "PingFang SC", "HarmonyOS Sans SC", "MiSans", "Source Han Sans SC", "Noto Sans SC", "Microsoft YaHei", -apple-system, sans-serif;
  /* 数字字体：Barlow 子集增强默认关闭（ADR-008），回落系统等宽数字 */
  --font-num: "DIN Alternate", "SF Pro Display", "Helvetica Neue", "PingFang SC", sans-serif;

  /* 行高：字号配对（UIUX §5.2 八档一一映射） */
  --leading-xs: 1.5;
  --leading-sm: 1.5;
  --leading-base: 1.55;
  --leading-lg: 1.4;
  --leading-xl: 1.35;
  --leading-2xl: 1.2;
  --leading-3xl: 1.1;
  --leading-4xl: 1.2;
  /* 长文阅读（规则要点段落） */
  --leading-relaxed: 1.7;
  /* 语义别名：与上方同值档位一一对应，保留供既有引用沿用 */
  --leading-body: 1.55;
  --leading-tight: 1.35;
  --leading-display: 1.2;

  /* ---------- A2-semantic ---------- */
  /* 冲/稳/保 三档（行业通用心智） */
  --tier-chong: #855C35;
  --tier-chong-bg: #F7F0E6;
  --tier-wen: #245D50;
  --tier-wen-bg: #EDF3EE;
  --tier-bao: #4D6B82;
  --tier-bao-bg: #EDF2F7;
  /* 趋势方向：教育语义 —— 绿=进步（位次下降）/ 红=退步（位次上升） */
  --trend-up: #126A32;
  --trend-up-bg: #E9F5EE;
  --trend-down: #C0392B;
  --trend-down-bg: #FBECEA;
  /* 通用语义 */
  --success: #126A32;
  --warn: #B45309;
  --warn-bg: #FBF3E4;
  --danger: #B91C1C;
  /* 图表容纳底（≈ --fg 5% on --bg） */
  --canvas: #E9EBEB;

  /* 动效 */
  --motion-fast: 120ms;
  --motion-base: 150ms;
  --motion-enter: 250ms;
  --ease-standard: cubic-bezier(0.2, 0, 0, 1);

  /* ---------- B-slot ---------- */
  --elev-flat: none;
  --elev-ring: 0 0 0 1px var(--border);
  --elev-raised: 0 1px 2px rgba(20, 24, 26, 0.04), 0 4px 10px rgba(20, 24, 26, 0.05);
  --focus-ring: 0 0 0 3px rgba(11, 132, 120, 0.28);

  --radius-sm: 6px;
  --radius-md: 10px;
  --radius-lg: 16px;
  --radius-pill: 9999px;

  /* 常规控件 48px；导航独立控件至少 44px。 */
  --tap-min: 48px;

  --space-1: 4px;
  --space-2: 8px;
  --space-3: 12px;
  --space-4: 16px;
  --space-5: 20px;
  --space-6: 24px;
  --space-8: 32px;
  --space-10: 40px;
  --space-12: 48px;

  --text-xs: 15px;
  --text-sm: 15px;
  --text-base: 17px;
  --text-lg: 20px;
  --text-xl: 24px;
  --text-2xl: 28px;
  --text-3xl: 34px;
  --text-4xl: 40px;
}
