@import "../../base.wxss";
/* 参照库：录取线 / 指标生对照 / 规则要点 */

.search {
  gap: var(--space-2);
  color: var(--muted);
}
/* 用类选择器而非后代标签选择器（`.search input`）：页面样式一旦被组件复用，
 * 标签选择器在自定义组件 wxss 里是非法的（门禁 §10.1）。 */
.search .search-field {
  font-family: var(--font-body);
  font-size: var(--text-base);
  font-weight: 400;
}

/* 我的位次联动说明 */
.info-bar {
  display: flex;
  align-items: flex-start;
  gap: 6px;
  padding: var(--space-3);
  border-radius: var(--radius-md);
  background: var(--accent-subtle);
  font-size: var(--text-sm);
  line-height: var(--leading-sm);
  color: var(--fg-2);
}
.info-ic {
  color: var(--accent);
  flex: none;
  margin-top: 1px;
}

/* 目标校条：一条轻底状态行，不做成第二个卡片（低打扰） */
.target-bar {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  min-height: 36px;
  padding: 0 var(--space-3);
  border-radius: var(--radius-sm);
  background: var(--surface-2);
  font-size: var(--text-sm);
  line-height: var(--leading-sm);
  color: var(--fg-2);
}
.target-k {
  flex: none;
  font-size: var(--text-xs);
  font-weight: 510;
  color: var(--accent);
  letter-spacing: 0.02em;
}
.target-v {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: var(--fg);
}
.target-x {
  flex: none;
  min-height: var(--tap-min);
  display: flex;
  align-items: center;
  padding-left: var(--space-2);
  font-size: var(--text-xs);
  color: var(--muted);
}

/* 排序行：标签 + 两枚分段式 chip，与批次筛选同一节奏 */
.sort-row {
  align-items: center;
}
.sort-k {
  flex: none;
  font-size: var(--text-xs);
  color: var(--muted);
  letter-spacing: 0.02em;
  padding-right: var(--space-1);
}

/* 行内「目标校」标记：浅底 + accent 文字，不做彩色左边框 */
.chip.target {
  background: var(--accent-subtle);
  color: var(--accent);
}

/* 学校行：校名一行，分数/位次/批次一行 */
.sch-row {
  min-height: 66px;
  align-items: flex-start;
}
.school-name {
  font-size: var(--text-base);
  line-height: var(--leading-base);
  color: var(--fg);
}
.school-meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 6px;
  margin-top: var(--space-1);
  font-size: var(--text-xs);
  line-height: var(--leading-xs);
  color: var(--muted);
}
.school-meta .chip {
  min-height: 22px;
  padding: 0 6px;
}
.school-side {
  flex: none;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 4px;
  padding-top: 2px;
}
.gap {
  font-size: var(--text-xs);
  line-height: var(--leading-xs);
  color: var(--fg-2);
}
.chev {
  color: var(--muted);
  line-height: 0;
  flex: none;
  padding-top: 6px;
}

/* 指标生筛选 */
.tier-chips {
  margin-top: var(--space-3);
}

/* 单校下钻面板 */
.detail {
  border-color: var(--accent);
}
.detail-head {
  display: flex;
  align-items: flex-start;
  gap: var(--space-2);
}
.detail-sub {
  margin-top: 2px;
}
.detail-actions {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  flex-wrap: wrap;
  margin-top: var(--space-2);
}
.compete {
  background: var(--accent-subtle);
  border-radius: var(--radius-md);
  padding: var(--space-3);
  display: flex;
  flex-direction: column;
  gap: 2px;
}
.compete-k {
  font-size: var(--text-sm);
  line-height: var(--leading-sm);
  color: var(--fg-2);
}
.compete-v {
  font-size: var(--text-2xl);
  line-height: var(--leading-2xl);
  font-weight: 590;
  color: var(--accent);
  letter-spacing: -0.01em;
}
.compete-note {
  font-size: var(--text-sm);
  line-height: var(--leading-sm);
  font-weight: 510;
  color: var(--warn);
}
.compete-cap {
  font-size: var(--text-xs);
  line-height: var(--leading-xs);
  color: var(--muted);
}

/* 硬门槛校验 */
.gate {
  border-radius: var(--radius-md);
  padding: var(--space-3);
  display: flex;
  flex-direction: column;
  gap: var(--space-1);
}
.gate.ok {
  background: var(--trend-up-bg);
}
.gate.warn {
  background: var(--warn-bg);
}
.gate-h {
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: var(--text-base);
  line-height: var(--leading-base);
  font-weight: 510;
}
.gate.ok .gate-h {
  color: var(--trend-up);
}
.gate.warn .gate-h {
  color: var(--warn);
}
.gate-b {
  font-size: var(--text-xs);
  line-height: var(--leading-body);
  color: var(--fg-2);
}

/* 规则要点 */
.rule-row {
  align-items: flex-start;
  min-height: 56px;
  padding: var(--space-3) 0;
}
.rule-no {
  flex: none;
  width: 72rpx;
  font-size: var(--text-sm);
  line-height: var(--leading-sm);
  font-weight: 590;
  color: var(--accent);
  padding-top: 2px;
}
.rule-detail {
  margin-top: var(--space-2);
  font-size: var(--text-sm);
  color: var(--muted);
  /* 规则要点为长文阅读场景，用 relaxed 而非 sm 档行高 */
  line-height: var(--leading-relaxed);
}

.seg,.tabs{background:#edf2f7}.seg-item.on,.tab.on{color:#4d6b82}.card{box-shadow:none}.school-rank,.rank{color:#4d6b82}

.segment{background:#edf2f7;border:0;padding:4px}.segment .seg-item.on{background:white;color:#4d6b82;box-shadow:none}.filter-toggle{display:flex;align-items:center;justify-content:space-between;min-height:44px;font-size:15px;color:#4d6b82}.card.flush{border:0;border-radius:0;background:transparent}.rows.pad-x{padding:0}.sch-row{padding:20px 0;border-color:#e2e8e2}.school-name{font-weight:500}.school-meta{gap:8px}.ph-meta{font-size:15px;color:#65736b}.school-side .chip{border:0}.card-foot{padding:12px 0}

/* 2.3.1 — readable type hierarchy; keep layout flexible. */
.school-name{font-size:17px;line-height:1.5;font-weight:600}.school-meta,.gap,.ph-meta{font-size:15px;line-height:1.5}.filter-toggle{font-size:17px;line-height:1.5;min-height:48px}.search .search-field{font-size:18px}.school-meta{row-gap:4px}.school-side{max-width:32%;gap:8px}.sch-row{gap:12px}.rule-no{font-size:17px;line-height:1.5;width:32px}.rule-detail{font-size:17px;line-height:1.7}.compete-k,.compete-note{font-size:17px;line-height:1.55}.compete-cap{font-size:15px;line-height:1.5}.target-bar{flex-wrap:wrap;min-height:48px;padding:8px 12px}.target-v{white-space:normal}.sort-row{row-gap:8px}
