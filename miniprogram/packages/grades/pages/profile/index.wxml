<nav-bar title="成绩设置" show-back="{{true}}"/>
<view class="page safe-bottom settings-page">
 <view class="settings-group"><button class="settings-row" data-section="backup" bindtap="toggle">数据备份<ui-icon name="{{openSection === 'backup' ? 'chevron-up' : 'chevron-down'}}" size="20px"/></button><view wx:if="{{openSection === 'backup'}}" class="settings-content"><view class="note">换手机或清理数据前，请先确认同步或导出备份。</view><view class="btn-row"><button bindtap="onExport" disabled="{{exporting}}">导出备份</button><button bindtap="onImport" disabled="{{importing}}">导入备份</button></view></view>
 <button class="settings-row" data-section="school" bindtap="toggle">所在学校<view class="settings-value"><text>{{mySchool || '未设置'}}</text><ui-icon name="chevron-right" size="18px"/></view></button><view wx:if="{{openSection === 'school'}}" class="settings-content"><picker range="{{schoolNames}}" value="{{schoolIndex}}" bindchange="onPickSchool"><view class="input"><text>{{mySchool || '选择学校'}}</text><ui-icon name="chevron-down" size="18px"/></view></picker></view>
 <button class="settings-row" data-section="data" bindtap="toggle">参照数据<ui-icon name="{{openSection === 'data' ? 'chevron-up' : 'chevron-down'}}" size="20px"/></button><view wx:if="{{openSection === 'data'}}" class="settings-content"><kv-list items="{{metaKv}}"/><button bindtap="onImportDataset">导入新年度数据</button></view>
 <button class="settings-row" data-section="privacy" bindtap="toggle">数据说明<ui-icon name="{{openSection === 'privacy' ? 'chevron-up' : 'chevron-down'}}" size="20px"/></button><view wx:if="{{openSection === 'privacy'}}" class="settings-content"><view class="note">{{disclaimer}}</view><view class="note" wx:if="{{meta}}">{{meta.sourceNote}}</view></view></view>
</view>
