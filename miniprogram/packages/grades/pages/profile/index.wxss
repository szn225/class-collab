@import "../../base.wxss";
/* 设置页：分组卡片 + 标题图标 + 双按钮 */

.title-row {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  min-width: 0;
}
.title-ic {
  color: var(--accent);
  flex: none;
}
.btn-row {
  display: flex;
  gap: var(--space-2);
  margin-top: var(--space-3);
}
.btn-row .btn {
  flex: 1;
  min-width: 0;
  padding: 0 var(--space-3);
}
.note-gap {
  margin-top: var(--space-3);
}
.chev {
  margin-left: auto;
  color: var(--muted);
  line-height: 0;
  flex: none;
}
.input .val.body {
  font-family: var(--font-body);
  font-size: var(--text-base);
  font-weight: 400;
}
.src {
  margin-top: var(--space-2);
}
.center {
  text-align: center;
}
