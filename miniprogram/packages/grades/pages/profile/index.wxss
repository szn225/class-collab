@import "../../base.wxss";
/* 设置页：分组卡片 + 标题图标 + 双按钮 */

.title-row {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  min-width: 0;
}
.title-ic {
  color: var(--accent);
  flex: none;
}
.btn-row {
  display: flex;
  gap: var(--space-2);
  margin-top: var(--space-3);
}
.btn-row .btn {
  flex: 1;
  min-width: 0;
  padding: 0 var(--space-3);
}
.note-gap {
  margin-top: var(--space-3);
}
.chev {
  margin-left: auto;
  color: var(--muted);
  line-height: 0;
  flex: none;
}
.input .val.body {
  font-family: var(--font-body);
  font-size: var(--text-base);
  font-weight: 400;
}
.src {
  margin-top: var(--space-2);
}
.center {
  text-align: center;
}

.settings-group{border:1px solid #e3e9dd;background:#fff;border-radius:16px;overflow:hidden}.settings-group>button.settings-row{width:100%;max-width:none;display:flex;justify-content:space-between;align-items:center;margin:0;padding:0 18px;min-height:58px;background:#fff;color:#304c37;border-radius:0;border-bottom:1px solid #eef2e9;font-size:14px}.settings-row::after{border:0}.settings-row text{font-size:12px;color:#819176}.settings-content{padding:18px;background:#fafbf8}.settings-content button{font-size:13px;color:#3f644a;background:#e9f0e4;border:0;border-radius:10px}.settings-content .note+.note{margin-top:12px}

.card{box-shadow:none;border-radius:16px}.section-title{color:#65736b}
