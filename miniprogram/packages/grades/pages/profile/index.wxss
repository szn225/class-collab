@import "../../base.wxss";
/* 设置页：分组卡片 + 标题图标 + 双按钮 */

.title-row {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  min-width: 0;
}
.title-ic {
  color: var(--accent);
  flex: none;
}
.btn-row {
  display: flex;
  gap: var(--space-2);
  margin-top: var(--space-3);
}
.btn-row .btn {
  flex: 1;
  min-width: 0;
  padding: 0 var(--space-3);
}
.note-gap {
  margin-top: var(--space-3);
}
.chev {
  margin-left: auto;
  color: var(--muted);
  line-height: 0;
  flex: none;
}
.input .val.body {
  font-family: var(--font-body);
  font-size: var(--text-base);
  font-weight: 400;
}
.src {
  margin-top: var(--space-2);
}
.center {
  text-align: center;
}

.settings-group{border:1px solid #e3e9dd;background:var(--surface);border-radius:16px;overflow:hidden}.settings-group>button.settings-row{width:100%;max-width:none;display:flex;justify-content:space-between;align-items:center;margin:0;padding:0 18px;min-height:58px;background:var(--surface);color:#304c37;border-radius:0;border-bottom:1px solid #eef2e9;font-size:15px}.settings-row::after{border:0}.settings-row text{font-size:15px;color:#65736b}.settings-content{padding:18px;background:var(--bg)}.settings-content button{font-size:15px;color:#3f644a;background:#e9f0e4;border:0;border-radius:10px}.settings-content .note+.note{margin-top:12px}

.card{box-shadow:none;border-radius:16px}.section-title{color:#65736b}

/* 2.3.1 — readable type hierarchy; keep layout flexible. */
.settings-group>button.settings-row{font-size:16px;line-height:1.55;min-height:60px;padding:14px 18px;gap:16px;white-space:normal;text-align:left}.settings-row text{font-size:15px;line-height:1.5;max-width:50%;text-align:right;color:#65736b}.settings-content button{font-size:16px;line-height:1.5;min-height:48px;white-space:normal;padding:12px}.settings-content{padding:20px}.btn-row{flex-wrap:wrap}

.settings-value{display:flex;align-items:center;gap:8px;max-width:55%}.settings-value text{max-width:none}.settings-row ui-icon{flex:none}

@import "../../styles/line-theme.wxss";
