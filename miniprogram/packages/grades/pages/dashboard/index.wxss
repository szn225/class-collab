@import "../../base.wxss";
@import "../../styles/line-theme.wxss";
.dashboard-context{display:flex;align-items:center;justify-content:space-between;gap:12px;min-height:44px}
.exam-context-name{font-size:var(--text-base);line-height:1.5;font-weight:500;overflow:hidden;white-space:nowrap;text-overflow:ellipsis;flex:1;min-width:0}
.dashboard-context>button.icon-action{width:44px;max-width:none;height:44px;min-height:44px;display:flex;align-items:center;justify-content:center;flex:none;background:transparent;padding:0;margin:0;border:0;color:var(--muted)}.icon-action::after{border:0}
.saved-confirmation{display:flex;align-items:center;gap:8px;background:var(--accent-subtle);border:1px solid var(--border);border-radius:10px;color:var(--accent);font-size:var(--text-sm);padding:10px 12px}
.card.flush{border:0;background:transparent;border-radius:0}.card-h{padding:8px 0}.exam-rows.pad-x{padding:0}
.exam-rows .row{display:flex;flex-direction:column;align-items:stretch;gap:8px;min-height:96px;padding:18px 0;border-color:var(--border-soft)}
.exam-row-head{display:flex;align-items:flex-start;gap:8px;min-width:0}.exam-row-head .ttl{flex:1;min-width:0;font-size:var(--text-base);font-weight:500;line-height:1.5;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.row-rank{flex:none;max-width:58%;font-size:var(--text-sm);line-height:1.6;color:var(--data);white-space:nowrap}.chev{display:flex;align-items:center;flex:none;min-height:24px;line-height:0}
.exam-row-info{min-width:0}.exam-meta{display:flex;align-items:center;gap:10px;min-height:24px;font-size:var(--text-sm);line-height:1.6;color:var(--muted)}.exam-meta .cap{margin:0;white-space:nowrap}.exam-meta .chip{min-height:24px;padding:0 7px;font-weight:400;background:var(--surface-2);color:var(--fg-2);white-space:nowrap}
.exam-tier{display:block;margin-top:6px;font-size:var(--text-sm);line-height:1.6;color:var(--muted)}
.target-tip{margin-top:8px}.sk-hero{height:164px;border-radius:var(--radius-lg)}.sk-tiers{display:flex;gap:8px}.sk-tier{flex:1;height:72px;border-radius:var(--radius-md)}.sk-block{height:220px;border-radius:var(--radius-lg)}

.student-switch{display:flex;align-items:center;justify-content:space-between;width:100%;min-height:48px;margin:0 0 16px;padding:12px 16px;background:var(--surface);color:var(--fg);border:1px solid var(--border);border-radius:12px;font-size:16px;line-height:1.5;gap:12px;text-align:left}.student-switch>text{min-width:0;overflow-wrap:break-word}.student-switch>view{display:flex;align-items:center;gap:6px;color:var(--accent);font-size:15px;flex-shrink:0}.record-more{font-size:15px;min-height:44px;color:var(--accent);background:transparent;border:0;margin:0;padding:8px 0;text-align:left;width:auto;justify-content:flex-start}
