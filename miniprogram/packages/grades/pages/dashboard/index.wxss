@import "../../base.wxss";
/* 定位首页：页级操作 / 记录列表 / 骨架屏 */

.exam-rows .row {
  min-height: 66px;
  padding: var(--space-2) 0;
}
.exam-meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 6px;
  margin-top: var(--space-1);
}
.exam-meta .chip {
  min-height: 22px;
  padding: 0 6px;
}
.exam-meta .cap {
  margin-top: 0;
}
.row-rank {
  flex: none;
  max-width: 240rpx;
  text-align: right;
  font-size: var(--text-sm);
  line-height: var(--leading-sm);
  color: var(--fg-2);
}
.chev {
  color: var(--muted);
  margin-left: var(--space-1);
  flex: none;
  line-height: 0;
}

/* 目标校回显：一行低干扰说明，不做第二个卡片 */
.target-tip {
  margin-top: var(--space-2);
}

/* 骨架屏 */
.sk-hero {
  height: 164px;
  border-radius: var(--radius-lg);
}
.sk-tiers {
  display: flex;
  gap: var(--space-2);
}
.sk-tier {
  flex: 1;
  height: 72px;
  border-radius: var(--radius-md);
}
.sk-block {
  height: 220px;
  border-radius: var(--radius-lg);
}

.saved-confirmation{padding:14px 16px;background:#e1efe4;color:#245d50;border-radius:12px;font-weight:600;font-size:16px}

.saved-confirmation{background:#edf4e8;border:1px solid #dce9d4;border-radius:12px;font-size:15px;padding:12px 16px;font-weight:500}.ph-meta{font-size:15px;line-height:1.7;color:#65736b;padding:0 4px}.exam-rows .ttl{font-size:15px;font-weight:500}.exam-rows .row{min-height:76px}.card-h .h2{font-size:17px}.row-rank{font-size:15px;color:#355b43}

.dashboard-context{display:flex;align-items:center;justify-content:space-between;gap:12px;min-height:32px}.ph-meta{font-size:15px;color:#65736b;padding:0;flex:1}.manage-link{font-size:15px;color:#245d50;padding:8px 0 8px 12px;min-height:44px}.card.flush{border:0;background:transparent;border-radius:0}.card-h{padding:8px 0}.exam-rows.pad-x{padding:0}.exam-rows .row{border-color:#e6e9ed}.row-rank{color:#4d6b82}

