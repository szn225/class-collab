@import "../../base.wxss";
.record-page{gap:16px;padding:20px 16px calc(110px + env(safe-area-inset-bottom))}.card{box-shadow:none;border:1px solid #e5e9e2;border-radius:16px;background:#fff}.entry-form{padding:20px}.form-section-title,.section-heading{font-size:15px;font-weight:600;color:#253f31;margin-bottom:8px}.field{padding:14px 0;border:0}.field+.field{border-top:1px solid #f0f2ed;margin:0}.lab{font-size:13px;color:#687b68;margin-bottom:10px}.req{color:#a55940}.input{height:44px;display:flex;align-items:center;justify-content:space-between;padding:0 12px;background:#f7f9f5;border:1px solid #e7ece3;border-radius:9px;font-size:15px;color:#2c4434}.input input{width:100%;height:42px;line-height:42px;min-height:0;font-weight:400;font-size:15px}.input.err{border-color:#b96e51}.hint,.field-error,.save-error{font-size:12px;color:#a34f34;line-height:1.6;margin-top:6px}.seg{display:flex;gap:4px;padding:4px;background:#f1f4ee;border-radius:10px}.seg-item{flex:1;line-height:36px;text-align:center;font-size:12px;color:#74816f;border-radius:7px}.seg-item.on{background:white;color:#2c5a43;font-weight:600;box-shadow:0 1px 4px rgba(30,60,40,.06)}.subject-card{padding:20px 20px 4px}.section-heading{display:flex;justify-content:space-between;align-items:center}.section-meta{font-size:12px;color:#81907c;font-weight:400}.score-row{height:54px;display:flex;align-items:center;justify-content:space-between;border-top:1px solid #eef2e9}.score-row:first-of-type{border-top:0}.score-name{font-size:15px;color:#314a38}.score-entry{display:flex;align-items:center;gap:10px;font-size:12px;color:#82907a}.score-entry input{width:100px;height:38px;line-height:38px;border:0;text-align:right;font-size:17px;color:#284d36;min-height:0;font-weight:500}.more-toggle{display:flex;align-items:center;justify-content:space-between;padding:4px 8px;min-height:44px;font-size:13px;color:#76856d}.extra-fields{padding:6px 20px}.chips{display:flex;gap:8px}.chipbtn{padding:6px 14px;border:1px solid #e0e7d9;border-radius:8px;font-size:13px}.chipbtn.on{background:#e4eee0;color:#2b5c3e}.save-bar{position:fixed;bottom:0;left:0;right:0;z-index:110;padding:12px 20px calc(12px + env(safe-area-inset-bottom));background:#fff;border-top:1px solid #edf0e8}.save-bar>button.save-primary{width:100%;max-width:none;display:block;margin:0;height:48px;line-height:48px;background:#285b4b;color:white;border-radius:12px;font-size:16px;font-weight:500;letter-spacing:1px}.save-primary::after{border:0}.save-error{margin:0 0 8px}.draft-notice{font-size:12px;color:#798972;padding:4px}.nav-more{padding:10px;font-size:18px}

.entry-form .field{display:grid;grid-template-columns:76px minmax(0,1fr);column-gap:12px;align-items:center;min-height:56px;padding:10px 0}.entry-form .lab{margin:0;font-size:13px;line-height:1.6}.entry-form .input{border:0;background:transparent;width:100%;padding:0;font-size:14px}.entry-form .input input{text-align:right;font-size:14px}.entry-form .field>.hint{grid-column:2}.entry-form .seg-item{font-size:11px;line-height:32px;white-space:nowrap}.entry-form picker{min-width:0}.entry-form .seg{min-width:0}.entry-form .form-section-title{padding-bottom:8px;margin:0}.entry-form .field:first-of-type{border:0}.score-row{height:48px}.score-entry input{font-size:16px}
