@import "../../base.wxss";
.record-page{padding:20px 16px calc(112px + env(safe-area-inset-bottom));gap:16px}.entry-form{padding:22px 20px}.field+.field{margin-top:22px}.lab{font-size:14px;color:#4e6055;margin-bottom:10px;font-weight:500;display:flex;align-items:center;gap:4px}.req{color:#a85d3b;font-size:12px}.input{height:48px;min-height:48px;padding:0 12px;border:1px solid #dde5df;background:#fbfcfa;border-radius:10px;display:flex;align-items:center;justify-content:space-between;font-size:16px;gap:8px}.input input{height:46px;line-height:46px;min-height:0;width:100%;font-size:16px;color:#263e30}.input.err{border-color:#b76d4c}.hint,.save-error{color:#a34e32;font-size:13px;line-height:1.6;margin-top:8px}.seg{display:flex;padding:4px;gap:3px;background:#f0f3ef;border-radius:12px}.seg-item{flex:1;text-align:center;font-size:13px;line-height:40px;color:#6f7e72;border-radius:9px}.seg-item.on{background:white;color:#285b4b;box-shadow:0 2px 6px rgba(0,0,0,.04);font-weight:600}.fold-head{display:flex;justify-content:space-between;align-items:center;padding:20px;font-size:14px;color:#53675a}.extra-card{padding:0}.optional{display:flex;align-items:center;gap:4px;font-size:12px;color:#869285}.extra-fields{padding:0 20px 20px}.subrow{display:flex;align-items:center;gap:6px;margin-bottom:10px}.subrow-name,.subrow-num{height:44px;min-width:0;padding:0 8px;background:#f8faf7;border:1px solid #dde5df;border-radius:8px;font-size:13px}.subrow-name{flex:1}.subrow-num{width:58px;text-align:center}.chips{display:flex;gap:8px;flex-wrap:wrap}.chipbtn{font-size:13px;padding:7px 12px;border:1px solid #dce4dc;border-radius:8px;color:#657568}.chipbtn.on{background:#e4eee4;border-color:#94b49a;color:#285b4b}.grow{flex:1;min-width:0}.save-bar{position:fixed;left:0;right:0;bottom:0;z-index:110;padding:16px 20px calc(16px + env(safe-area-inset-bottom));background:#fff;border-top:1px solid #e7ece5}.save-primary{height:52px;line-height:52px;width:100%;margin:0;background:#285b4b;color:white;border-radius:13px;font-size:17