@import "../../base.wxss";
@import "../../styles/line-theme.wxss";
.record-page{padding:20px 20px calc(164px + min(20px,env(safe-area-inset-bottom)));gap:16px}
.record-page .entry-form{padding:4px 16px;background:var(--surface);border:1px solid var(--border);border-radius:var(--radius-lg)}
.entry-form .field{display:grid;grid-template-columns:88px minmax(0,1fr);column-gap:8px;align-items:center;min-height:56px;padding:8px 0;border:0;border-bottom:1px solid var(--border-soft)}.entry-form .field:last-child{border:0}
.entry-form .lab{font-size:var(--text-base);line-height:1.5;color:var(--fg-2);margin:0}.req{color:var(--danger)}
.entry-form picker{min-width:0}.entry-form .input{display:flex;align-items:center;justify-content:flex-end;gap:8px;width:100%;min-height:44px;padding:0;border:0;border-radius:0;background:transparent;color:var(--fg);font-size:var(--text-base)}
.entry-form .input input{width:100%;height:44px;min-height:44px;text-align:right;font-size:var(--text-base);font-weight:400;color:var(--fg)}.entry-form .date-input text{text-align:right;overflow-wrap:break-word}.entry-form .field>.hint{grid-column:2}.input.err{color:var(--danger)}
.record-page .optional-fields{padding:0 16px;background:var(--surface);border:1px solid var(--border);border-radius:var(--radius-lg);overflow:hidden}
.subject-card{border:0}.subject-card>button.subject-toggle,.optional-fields>button.more-toggle{display:flex;align-items:center;justify-content:space-between;gap:12px;width:100%;max-width:none;min-height:56px;padding:14px 0;margin:0;border:0;border-radius:0;background:transparent;color:var(--fg);font-size:var(--text-base);line-height:1.5;font-weight:500;text-align:left}
.optional-fields>button.more-toggle{border-top:1px solid var(--border-soft)}.subject-toggle::after,.more-toggle::after{border:0}
.section-actions{display:flex;align-items:center;gap:8px;flex:none}.section-meta{font-size:var(--text-sm);color:var(--muted);font-weight:400}
.subject-fields{padding-bottom:12px}.score-row{display:flex;align-items:center;justify-content:space-between;gap:12px;min-height:56px;padding:6px 0;border-top:1px solid var(--border-soft)}.score-name{font-size:var(--text-base);color:var(--fg)}.score-entry{display:flex;align-items:center;gap:8px;font-size:var(--text-sm);color:var(--muted);flex:none}.score-entry input{width:80px;height:44px;border:1px solid var(--border);border-radius:8px;background:var(--surface);text-align:center;font-size:var(--text-base);font-weight:400;color:var(--accent)}
.extra-fields{padding:0 0 16px}.extra-fields .field{padding:12px 0;border-color:var(--border-soft)}.extra-fields .input{min-height:48px;font-size:var(--text-base)}.extra-fields .input input{font-size:var(--text-base)}.extra-fields .chips{flex-wrap:wrap}.extra-fields .chipbtn{font-size:var(--text-sm);min-height:44px}
.hint,.field-error,.save-error{font-size:var(--text-sm);color:var(--danger);line-height:1.6}.draft-notice{font-size:var(--text-sm);color:var(--muted);padding:0 4px}
.save-bar{position:fixed;left:0;right:0;bottom:calc(52px + min(20px,env(safe-area-inset-bottom)));z-index:110;padding:12px 20px;background:var(--bg);border-top:1px solid var(--border-soft)}.save-bar>button.save-primary{display:flex;align-items:center;justify-content:center;width:100%;max-width:none;min-height:48px;margin:0;padding:12px 16px;border:0;border-radius:var(--radius-md);background:var(--accent);color:var(--accent-on);font-size:var(--text-base);font-weight:500;line-height:24px}.save-primary::after{border:0}.save-error{margin-bottom:8px}

.record-context{font-size:16px;line-height:1.6;margin-bottom:6px;color:var(--fg-2)}.record-context text{font-weight:600;color:var(--fg)}.scope-explanation{font-size:15px;line-height:1.7;color:var(--muted);margin-bottom:16px}
