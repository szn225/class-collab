.record-heading{padding:8px 4px 4px}.record-eyebrow{font-size:11px;letter-spacing:2px;color:#7d8b7f;margin-bottom:8px}.record-title{font-size:24px;font-weight:600;letter-spacing:.5px;color:#244433}.form-section-title{font-size:12px;color:#819081;margin-bottom:24px;letter-spacing:1px}.record-page{gap:18px;padding-bottom:calc(130px + env(safe-area-inset-bottom))}.entry-form{border-color:#e4e9e0;border-radius:20px;padding:24px 20px}.input{border-color:#e2e7dd;border-radius:12px;background:#fafbf8}.input:focus-within{border-color:#789780}.lab{color:#506551}.extra-card{border-radius:18px}.save-bar{display:flex;align-items:center;flex-wrap:wrap;gap:14px;padding:14px 20px calc(14px + env(safe-area-inset-bottom));border-top-color:#e7ece2}.save-bar>button.save-primary{width:auto;flex:1;height:50px;line-height:50px;font-size:16px;border-radius:14px}.storage-note{font-size:12px;line-height:44px;margin:0;padding:0 6px;background:transparent;color:#748371}.storage-note::after{border:0}.storage-note text{margin-left:4px}.save-error{width:100%;order:-1}.record-link{color:#456c53;font-size:12px}.draft-notice{font-size:12px;background:#edf2e9;border-radius:10px;padding:10px 12px}
