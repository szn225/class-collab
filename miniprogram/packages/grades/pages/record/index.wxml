<nav-bar title="录入成绩" show-back="{{true}}"/>

<view class="page record-page">
 <view class="record-context">正在为 <text>{{studentName}}</text> 录入成绩</view>
 <view class="scope-explanation">{{form.scope === 'city' ? '全市统考：填写全市位次，可查看定位与趋势。' : form.scope === 'group' ? '集团联考：填写集团和排名，可折算定位。' : '校内考试：填写校排名和参考人数，仅用于校内追踪。'}}</view>
 <view wx:if="{{draftNotice}}" class="draft-notice">{{draftNotice}}</view>
 <view class="card entry-form">
  <view class="field"><view class="lab">考试名称 <text class="req">*</text></view><view class="input {{errors.examName ? 'err' : ''}}"><input value="{{form.examName}}" placeholder="例如：期中考试" data-field="examName" bindinput="onInput" maxlength="40" placeholder-class="input-placeholder" placeholder-style="font-size:15px;font-weight:400;color:#65736B"/></view><view wx:if="{{errors.examName}}" class="hint">{{errors.examName}}</view></view>
  <view class="field"><view class="lab">考试日期</view><picker mode="date" value="{{form.examDate}}" bindchange="onDateChange"><view class="input date-input"><text>{{form.examDate}}</text><ui-icon name="chevron-right" size="18px"/></view></picker></view>
  <view class="field"><view class="lab">考试类型</view><picker range="{{scopeOptions}}" range-key="label" value="{{scopeIndex}}" bindchange="onScopeChange"><view class="input date-input"><text>{{scopeOptions[scopeIndex].label}}</text><ui-icon name="chevron-down" size="16px"/></view></picker></view>
  <view wx:if="{{form.scope === 'group'}}" class="field"><view class="lab">所属集团 <text class="req">*</text></view><picker range="{{groups}}" value="{{groupIndex}}" bindchange="onGroupChange"><view class="input date-input {{errors.groupName ? 'err' : ''}}"><text>{{form.groupName || '请选择集团'}}</text><ui-icon name="chevron-right" size="18px"/></view></picker></view>
  <view wx:if="{{form.scope === 'city'}}" class="field"><view class="lab">全市位次 <text class="req">*</text></view><view class="input {{errors.cityRank ? 'err' : ''}}"><input type="number" value="{{form.cityRank}}" placeholder="填写成绩单上的全市排名" data-field="cityRank" bindinput="onInput" placeholder-class="input-placeholder" placeholder-style="font-size:15px;font-weight:400;color:#65736B"/></view><view wx:if="{{errors.cityRank}}" class="hint">{{errors.cityRank}}</view></view>
  <view wx:if="{{form.scope === 'group'}}" class="field"><view class="lab">集团排名 <text class="req">*</text></view><view class="input {{errors.groupRank ? 'err' : ''}}"><input type="number" value="{{form.groupRank}}" placeholder="填写集团联考排名" data-field="groupRank" bindinput="onInput" placeholder-class="input-placeholder" placeholder-style="font-size:15px;font-weight:400;color:#65736B"/></view><view wx:if="{{errors.groupRank}}" class="hint">{{errors.groupRank}}</view></view>
  <block wx:if="{{form.scope === 'school'}}"><view class="field"><view class="lab">校内排名 <text class="req">*</text></view><view class="input {{errors.schoolRank ? 'err' : ''}}"><input type="number" value="{{form.schoolRank}}" placeholder="填写校内排名" data-field="schoolRank" bindinput="onInput" placeholder-class="input-placeholder" placeholder-style="font-size:15px;font-weight:400;color:#65736B"/></view></view><view class="field"><view class="lab">参考人数 <text class="req">*</text></view><view class="input {{errors.schoolSize ? 'err' : ''}}"><input type="number" value="{{form.schoolSize}}" placeholder="本次考试的全校参考人数" data-field="schoolSize" bindinput="onInput" placeholder-class="input-placeholder" placeholder-style="font-size:15px;font-weight:400;color:#65736B"/></view></view></block>
 </view>
 <view class="card optional-fields"><view class="subject-card"><button class="section-heading subject-toggle" bindtap="onToggleSubjects" aria-expanded="{{showSubjects}}"><text>各科成绩</text><view class="section-actions"><text class="section-meta">选填</text><ui-icon wx:if="{{subjectError}}" name="error-circle" tone="negative" size="18px"/><ui-icon name="{{showSubjects ? 'chevron-up' : 'chevron-down'}}" size="20px"/></view></button><view wx:if="{{showSubjects}}" class="subject-fields"><view class="score-row" wx:for="{{form.subjects}}" wx:key="id"><text class="score-name">{{item.subject === '道法' ? '道德与法治' : item.subject}}</text><view class="score-entry"><input type="digit" value="{{item.score}}" placeholder="" placeholder-class="input-placeholder" data-index="{{index}}" data-key="score" bindinput="onSubjectInput" confirm-type="next"/><text>分</text></view></view><view wx:if="{{subjectError}}" class="field-error">{{subjectError}}</view></view></view>
 <button class="section-heading more-toggle" bindtap="onToggleMore" aria-expanded="{{showMore}}"><text>其他信息</text><view class="section-actions"><text class="section-meta">选填</text><ui-icon name="{{showMore ? 'chevron-up' : 'chevron-down'}}" size="20px"/></view></button>
 <view wx:if="{{showMore}}" class="extra-fields"><view wx:if="{{form.scope === 'group'}}" class="field"><view class="lab">校内排名</view><view class="input"><input type="number" value="{{form.schoolRank}}" data-field="schoolRank" bindinput="onInput" placeholder="选填" placeholder-class="input-placeholder" placeholder-style="font-size:15px;font-weight:400;color:#65736B"/></view></view><view wx:if="{{form.scope === 'group'}}" class="field"><view class="lab">学校参考人数</view><view class="input"><input type="number" value="{{form.schoolSize}}" data-field="schoolSize" bindinput="onInput" placeholder="选填" placeholder-class="input-placeholder" placeholder-style="font-size:15px;font-weight:400;color:#65736B"/></view></view><view wx:if="{{form.scope === 'group'}}" class="field"><view class="lab">集团参考人数</view><view class="input"><input type="number" value="{{form.groupSize}}" data-field="groupSize" bindinput="onInput" placeholder="选填" placeholder-class="input-placeholder" placeholder-style="font-size:15px;font-weight:400;color:#65736B"/></view></view><view wx:for="{{surveySubjects}}" wx:key="*this" class="field"><view class="lab">{{item}}等级</view><view class="chips"><view wx:for="{{gradeOptions}}" wx:for-item="g" wx:key="*this" class="chipbtn {{form.surveyGrades[item] === g ? 'on' : ''}}" data-subject="{{item}}" data-grade="{{g}}" bindtap="onPickGrade">{{g}}</view></view></view></view>
 </view>
</view>
<view class="save-bar"><view wx:if="{{saveError}}" class="save-error">{{saveError}}</view><button class="save-primary" bindtap="onSave" loading="{{saving}}" disabled="{{saving}}">{{saving ? '正在保存…' : '保存成绩'}}</button></view>

<grade-tabs value="{{gradeTab}}"/>
