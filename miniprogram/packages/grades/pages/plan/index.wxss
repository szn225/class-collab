@import "../../base.wxss";
/* 复盘清单：动作卡片 + 状态点 + 责任/时限/复检 */

.plan-card {
  /* 与全局 .card 一致（14px），避免复盘页卡片比其它页宽 2px */
  padding: 14px;
}
.pl-head {
  display: flex;
  align-items: flex-start;
  gap: var(--space-3);
}
.pl-title {
  font-size: var(--text-lg);
  font-weight: 510;
  color: var(--fg);
  line-height: var(--leading-lg);
}
.pl-tags {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-2);
  margin-top: var(--space-2);
}
.pl-status {
  display: flex;
  align-items: center;
  gap: 6px;
  flex: none;
  font-size: var(--text-sm);
  line-height: var(--leading-sm);
  padding-top: 2px;
}
.pl-status.muted {
  color: var(--muted);
}
.pl-status.doing {
  color: var(--accent);
}
.pl-status.done {
  color: var(--trend-up);
}
.dot.doing {
  background: var(--accent);
}
.dot.done {
  background: var(--trend-up);
}

.pl-meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 6px;
  margin-top: var(--space-3);
  padding-top: var(--space-3);
  border-top: var(--border-width) solid var(--border-soft);
  font-size: var(--text-sm);
  line-height: var(--leading-sm);
  color: var(--fg-2);
}
.pl-meta-sep {
  color: var(--muted);
}
.pl-actions {
  display: flex;
  justify-content: flex-end;
  margin-top: var(--space-2);
}
.pl-btn {
  min-height: var(--tap-min);
  padding: 0 var(--space-4);
  font-size: var(--text-sm);
}

.pl-meta-item {
  min-width: 0;
}

.action-card{border-color:#e2e8e2}.filter.on,.seg-item.on,.chip.on{background:#f0edf5;color:#756683}.card{box-shadow:none}.page>.card{border-radius:16px}

.segment{background:#f0edf5;border:0}.segment .seg-item.on{background:#fff;color:#756683;box-shadow:none}.pl-status.doing{color:#756683}.dot.doing{background:#756683}.pl-title{font-size:16px}.pl-meta{font-size:15px}

/* 2.3.1 — readable type hierarchy; keep layout flexible. */
.pl-title{font-size:17px;line-height:1.55;font-weight:600}.pl-meta{font-size:15px;line-height:1.5}.pl-status{font-size:15px;line-height:1.5}.pl-head{flex-wrap:wrap;gap:12px}.pl-head .grow{flex-basis:60%}.pl-actions{flex-wrap:wrap}.pl-btn{font-size:17px;min-height:48px;line-height:1.5}.plan-card{padding:20px}
