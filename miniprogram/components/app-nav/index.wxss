.nav{position:fixed;top:0;left:0;right:0;z-index:150;background:#fff;border-bottom:1px solid #eff1ec;box-sizing:border-box;font-family:-apple-system,'PingFang SC',sans-serif;color:#233c30}.nav-row{display:flex;align-items:center;box-sizing:border-box;padding-left:14px;gap:12px}.nav-leading{display:flex;align-items:center;border:1px solid #e3e8df;border-radius:18px;flex:none;height:34px}.nav-leading>button.nav-control{width:34px;min-width:34px;max-width:none;height:32px;min-height:32px;line-height:32px;display:flex;align-items:center;justify-content:center;padding:0;margin:0;background:transparent;border:0;border-radius:18px}.nav-control::after{border:0}.nav-control+.nav-control{border-left:1px solid #e7ece4;border-radius:0}.nav-title{font-size:17px;font-weight:600;flex:1;overflow:hidden;white-space:nowrap;text-overflow:ellipsis}.nav-actions{display:flex;align-items:center;gap:8px;flex:none;font-size:13px;color:#486752}.back-icon{width:8px;height:8px;border-left:2px solid #49634f;border-bottom:2px solid #49634f;transform:rotate(45deg);margin-left:4px}.home-icon{position:relative;width:12px;height:10px;border:1.7px solid #49634f;border-top:0;border-radius:1px;margin-top:6px;box-sizing:border-box}.home-icon::before{content:'';position:absolute;width:9px;height:9px;left:0;top:-5px;border-top:1.7px solid #49634f;border-left:1.7px solid #49634f;transform:rotate(45deg);border-radius:1px}.home-icon::after{content:'';position:absolute;bottom:-1px;left:3px;width:3px;height:5px;border:1px solid #49634f;background:#fff}.nav-actions:empty{display:none}
