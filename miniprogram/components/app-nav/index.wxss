@import "../../styles/tokens.wxss";
.nav{position:fixed;top:0;left:0;right:0;z-index:150;background:var(--ui-bg);border-bottom:1px solid var(--ui-line-soft);box-sizing:border-box;color:var(--ui-ink);font-family:-apple-system,'PingFang SC',sans-serif}
.nav-row{position:relative;display:flex;align-items:center;box-sizing:border-box;padding-left:4px;gap:6px}
.nav-leading{display:flex;align-items:center;flex:none;height:44px;z-index:1}
.nav-leading>button.nav-control{width:44px;min-width:44px;max-width:none;height:44px;min-height:44px;display:flex;align-items:center;justify-content:center;padding:0;margin:0;background:transparent;border:0;border-radius:8px}
.nav-control::after{border:0}.nav-title{position:absolute;left:96px;right:96px;text-align:center;overflow:hidden;white-space:nowrap;text-overflow:ellipsis;font-size:18px;line-height:1.4;font-weight:600;pointer-events:none}
.nav-actions{display:flex;align-items:center;margin-left:auto;z-index:1;font-size:15px;color:var(--ui-green)}.nav-actions:empty{display:none}
