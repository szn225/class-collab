.nav{position:fixed;top:0;left:0;right:0;z-index:150;background:#fff;border-bottom:1px solid #edf0eb;box-sizing:border-box;font-family:-apple-system,'PingFang SC',sans-serif;color:#263b37}.nav-row{position:relative;display:flex;align-items:center;box-sizing:border-box;padding-left:12px;gap:6px}.nav-leading{display:flex;align-items:center;flex:none;height:44px;z-index:1}.nav-leading>button.nav-control{width:36px;min-width:36px;max-width:none;height:44px;min-height:44px;display:flex;align-items:center;justify-content:center;padding:0;margin:0;background:transparent;border:0;border-radius:8px}.nav-control::after{border:0}.nav-title{position:absolute;left:88px;right:96px;text-align:center;overflow:hidden;white-space:nowrap;text-overflow:ellipsis;font-size:17px;font-weight:600;pointer-events:none}.nav-actions{display:flex;align-items:center;margin-left:auto;z-index:1;font-size:13px;color:#245d50}.nav-actions:empty{display:none}.back-icon{width:9px;height:9px;border-left:1.7px solid #245d50;border-bottom:1.7px solid #245d50;transform:rotate(45deg);margin-left:4px}.home-icon{position:relative;width:13px;height:11px;border:1.6px solid #245d50;border-top:0;border-radius:1px;margin-top:5px;box-sizing:border-box}.home-icon::before{content:'';position:absolute;width:9px;height:9px;left:0;top:-5px;border-top:1.6px solid #245d50;border-left:1.6px solid #245d50;transform:rotate(45deg)}.home-icon::after{content:'';position:absolute;bottom:-1px;left:3px;width:4px;height:6px;border:1px solid #245d50;background:#fff}